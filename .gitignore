# Runtime state and build products
worktrees/
system/state/
**/__pycache__/
**/.venv/
Evolve/kernel/builds/
Evolve/kernel/runs/
Evolve/kernel/evaluations/
Evolve/kernel/state*/
Evolve/kernel/rootfs/
Evolve/kernel/*.cpio.gz
Evolve/kernel/.runtime.lock
*.log
.env
.env.*

# Separate xswap discovery campaign artifacts
Evolve/xswap/runs/
Evolve/xswap/evaluations/
Evolve/xswap/state*/
