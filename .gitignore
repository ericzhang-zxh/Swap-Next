# Runtime state and build products
worktrees/
system/state/
**/__pycache__/
**/.venv/
Evolve/kernel/builds/
Evolve/kernel/runs/
Evolve/kernel/evaluations/
Evolve/kernel/state*/
Evolve/kernel/rootfs/
Evolve/kernel/*.cpio.gz
Evolve/kernel/.runtime.lock
*.log
.env
.env.*

# Separate xswap discovery campaign artifacts
Evolve/xswap/runs/
Evolve/xswap/evaluations/
Evolve/xswap/state*/
Evolve/xswap/rootfs/
Evolve/xswap/*.cpio.gz
Evolve/xswap/.runtime.lock
Evolve/xswap/initramfs.json
system/campaigns/xswap-reference-replay/

# Relocated benchmark runtime; retain old ignores for historical evidence.
benchmark/kernel/builds/
benchmark/kernel/runs/
benchmark/kernel/evaluations/
benchmark/kernel/state*/
benchmark/kernel/rootfs/
benchmark/kernel/*.cpio.gz
benchmark/kernel/.runtime.lock
benchmark/kernel/initramfs.json
benchmark/xswap/builds/
benchmark/xswap/runs/
benchmark/xswap/evaluations/
benchmark/xswap/state*/
benchmark/xswap/rootfs/
benchmark/xswap/*.cpio.gz
benchmark/xswap/.runtime.lock
benchmark/xswap/initramfs.json

# Lowercase adapter search state; historical uppercase runtime stays archived.
evolve/kernel/state*/
evolve/xswap/state*/

# Active controller state; retain system/state above for archived evidence.
evolve/control/state/
evolve/control/campaigns/xswap-reference-replay/

# Independent structural xswap campaign runtime.
benchmark/xswap-structure/builds/
benchmark/xswap-structure/runs/
benchmark/xswap-structure/evaluations/
benchmark/xswap-structure/state*/
benchmark/xswap-structure/rootfs/
benchmark/xswap-structure/*.cpio.gz
benchmark/xswap-structure/.runtime.lock
benchmark/xswap-structure/initramfs.json
evolve/xswap-structure/state*/

# Standard suite evaluation state.
evolve/swap-standard/state*/
benchmark/swap-standard/evaluations/

# Campaign directory runtime
campaigns/STOP
campaigns/*/runs/
campaigns/*/.lock
campaigns/*/STOP
campaigns/*/ledger/*.tmp
campaigns/*/ledger/.lock
campaigns/*/ledger/.*.lock
campaigns/*/candidates/*.json.tmp
campaigns/*/campaign.json.tmp
