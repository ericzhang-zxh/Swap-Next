#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Initramfs stage: mount the read-only benchmark root and run one workload in it.
export PATH=/bin:/sbin
fail() {
    echo "BENCH_FAIL $1"
    echo KERNEL_LOG_BEGIN
    dmesg
    echo KERNEL_LOG_END
    sleep 3
    poweroff -f
    exit 1
}
report_online_nodes() {
    if [ -e /sys/devices/system/node ]; then
        online_nodes=$(cat /sys/devices/system/node/online) || fail online_nodes
        [ -n "$online_nodes" ] || fail online_nodes
    elif [ "${topology_id:-single}" = single ]; then
        online_nodes=flat
    else
        fail online_nodes
    fi
    printf 'ONLINE_NODES %s\n' "$online_nodes"
}
mount -t proc proc /proc || fail proc
mount -t sysfs sysfs /sys || fail sysfs
mount -t devtmpfs devtmpfs /dev || fail devtmpfs
exec </dev/console >/dev/console 2>&1
echo BENCH_BOOT
uname -a
cat /proc/sys/kernel/random/boot_id
echo CMDLINE_BEGIN
cat /proc/cmdline
echo CMDLINE_END
arg() {
    for word in $(cat /proc/cmdline); do
        case "$word" in "$1"=*) echo "${word#*=}"; return;; esac
    done
}
backend=$(arg bench.backend)
mode=$(arg bench.mode)
workload=$(arg bench.workload)
revision=$(arg bench.protocol_revision)
config_id=$(arg bench.config_id)
correctness_case=$(arg bench.correctness_case)
correctness_group=$(arg bench.correctness_group)
compression_cases=$(arg bench.compression_cases)
topology_id=$(arg bench.topology_id)
compression_target_bytes=$(arg bench.compression_target_bytes)
[ -n "$backend" ] && [ -n "$mode" ] && [ -n "$workload" ] || fail cmdline
mkdir -p /bench
mount -t ext4 -o ro /dev/vdb /bench || fail benchroot
for d in proc sys dev; do
    mount --bind /$d /bench/$d || fail bind_$d
done
mount -t tmpfs -o mode=1777,size=24G tmpfs /bench/tmp || fail tmp
mount -t cgroup2 none /bench/sys/fs/cgroup || fail cgroup
mount -t debugfs debugfs /bench/sys/kernel/debug || fail debugfs
if [ "${revision:-0}" = 8 ]; then
    mount -t tracefs tracefs /bench/sys/kernel/tracing || fail tracefs
    mount -t tmpfs -o mode=0755,size=1M tmpfs /bench/run || fail guest_marker_mount
    printf 'swap-next-guest-v1\n' > /bench/run/swap-next-guest
    echo "GUEST_TOPOLOGY ${topology_id:-single}"
    report_online_nodes
    chroot /bench /bin/bash /opt/bench/bench.sh "$backend" "$mode" "$workload" "$revision" "$config_id" "$correctness_case" "$correctness_group" "$compression_cases" "${topology_id:-single}" "${compression_target_bytes:-0}" || fail workload
else
    chroot /bench /bin/bash /opt/bench/bench.sh "$backend" "$mode" "$workload" || fail workload
fi
echo KERNEL_LOG_BEGIN
dmesg
echo KERNEL_LOG_END
echo BENCH_PASS
chroot /bench /opt/bench/bin/console-drain || fail console_drain
poweroff -f
