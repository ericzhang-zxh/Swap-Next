From 4f83412c1d59eaf6a4d2460cb47fe0177a3be0c4 Mon Sep 17 00:00:00 2001
From: Eric Zhang <zxh@xh-zhang.com>
Date: Thu, 22 Oct 2026 01:16:07 -0700
Subject: [PATCH] mm: expose xswap occupancy and cache-only topology in debugfs

Retained mapped clusters alone cannot distinguish high referenced slots
from cache-only slots or temporarily unavailable empty clusters. Extend
the diagnostic read with nine occupancy and slot classification fields.
Keep the existing six fields and derive tail_free from the same scan.

Hold xswap_lock to preserve the mapped descriptor range and sample each
cluster under its lock. Skip table inspection for empty clusters and for
the reserved cluster after teardown removes its table. Reschedule only
after releasing the cluster lock. This is a rolling scan; counters from
different clusters need not describe one instant under concurrent load.

Cluster zero has a reserved bad slot, so its count contributes to the
nonempty cluster total and highest occupied/blocker endpoint. The bad
slot contributes to neither cache-only nor referenced page totals.
Endpoints use index plus one, with zero denoting no observed match.
Cache-only clusters contain cached zero-count slots and no positive-count
slots. These virtual slot counts do not count physical reverse-map flags.

The 15 unsigned fields occupy at most 561 bytes on 64-bit systems, leaving
space for the terminator in the fixed 640-byte output buffer. No
allocation, reclaim, or mapping policy changes are included.

Validation: git diff --check; checkpatch.pl --no-signoff (0 errors and
0 warnings). Runtime validation is reserved for controller review.

Assisted-by: LLM
---
 mm/swapfile.c | 82 ++++++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 68 insertions(+), 14 deletions(-)

diff --git a/mm/swapfile.c b/mm/swapfile.c
index 180cf538f..4f69ec37d 100644
--- a/mm/swapfile.c
+++ b/mm/swapfile.c
@@ -5107,37 +5107,91 @@ static void xswap_try_shrink(struct swap_info_struct *si)
 	mutex_unlock(&si->xswap_lock);
 }
 
-/* Not an interface: how far the mapped range has moved, for testing. */
+/* Not an interface: mapped range and occupancy, for testing. */
 static ssize_t xswap_debugfs_read(struct file *file, char __user *buf,
 				  size_t count, loff_t *ppos)
 {
 	struct swap_info_struct *si = file->private_data;
-	struct swap_cluster_info *ci;
-	unsigned long mapped, tail = 0;
-	char tmp[192];
+	struct {
+		unsigned long clusters_nonempty;
+		unsigned long clusters_free;
+		unsigned long highest_nonempty_plus1;
+		unsigned long highest_blocker_plus1;
+		unsigned long cache_only_pages;
+		unsigned long referenced_pages;
+		unsigned long highest_cache_only_plus1;
+		unsigned long highest_referenced_plus1;
+		unsigned long cache_only_clusters;
+	} stats = {};
+	unsigned long mapped, i, tail = 0;
+	char tmp[640];
 	int len;
 
 	/*
-	 * The same scan the shrink does.  xswap_lock is what keeps
-	 * cluster_info from being unmapped under it.
+	 * xswap_lock pins the mapping. Each cluster is sampled under its own
+	 * lock, so this is a rolling scan, not a device-wide atomic snapshot.
 	 */
 	mutex_lock(&si->xswap_lock);
 	mapped = READ_ONCE(si->nr_clusters_mapped);
 	if (si->cluster_info) {
-		while (mapped - tail > 1) {
-			ci = &si->cluster_info[mapped - tail - 1];
-			if (READ_ONCE(ci->count) ||
-			    READ_ONCE(ci->flags) != CLUSTER_FLAG_FREE)
-				break;
-			tail++;
+		for (i = 0; i < mapped; i++) {
+			struct swap_cluster_info *ci = &si->cluster_info[i];
+			unsigned int off, cache_only = 0, referenced = 0;
+
+			spin_lock(&ci->lock);
+			if (!ci->count && ci->flags == CLUSTER_FLAG_FREE)
+				stats.clusters_free++;
+			else
+				stats.highest_blocker_plus1 = i + 1;
+			if (ci->count) {
+				stats.clusters_nonempty++;
+				stats.highest_nonempty_plus1 = i + 1;
+			}
+			/* Teardown can leave the reserved count without a table. */
+			if (ci->count && cluster_table_is_alloced(ci)) {
+				for (off = 0; off < SWAPFILE_CLUSTER; off++) {
+					unsigned long entry = __swap_table_get(ci, off);
+
+					if (swp_tb_is_folio(entry) &&
+					    !swp_tb_get_count(entry))
+						cache_only++;
+					else if (swp_tb_get_count(entry) > 0)
+						referenced++;
+				}
+			}
+			spin_unlock(&ci->lock);
+			stats.cache_only_pages += cache_only;
+			stats.referenced_pages += referenced;
+			if (cache_only) {
+				stats.highest_cache_only_plus1 = i + 1;
+				if (!referenced)
+					stats.cache_only_clusters++;
+			}
+			if (referenced)
+				stats.highest_referenced_plus1 = i + 1;
+			cond_resched();
 		}
+		/* Cluster 0 remains mapped even if no blocker was observed. */
+		if (mapped)
+			tail = mapped - max(stats.highest_blocker_plus1, 1UL);
 	}
 	len = scnprintf(tmp, sizeof(tmp),
-			"clusters_max %lu\nclusters_mapped %lu\nusage_pages %lu\ntail_free %lu\ngrows %lu\nshrinks %lu\n",
+			"clusters_max %lu\nclusters_mapped %lu\nusage_pages %lu\n"
+			"tail_free %lu\ngrows %lu\nshrinks %lu\n"
+			"clusters_nonempty %lu\nclusters_free %lu\n"
+			"highest_nonempty_plus1 %lu\nhighest_blocker_plus1 %lu\n"
+			"cache_only_pages %lu\nreferenced_pages %lu\n"
+			"highest_cache_only_plus1 %lu\n"
+			"highest_referenced_plus1 %lu\ncache_only_clusters %lu\n",
 			READ_ONCE(si->nr_clusters_max), mapped,
 			swap_usage_in_pages(si), tail,
 			atomic_long_read(&si->xswap_grows),
-			atomic_long_read(&si->xswap_shrinks));
+			atomic_long_read(&si->xswap_shrinks),
+			stats.clusters_nonempty, stats.clusters_free,
+			stats.highest_nonempty_plus1, stats.highest_blocker_plus1,
+			stats.cache_only_pages, stats.referenced_pages,
+			stats.highest_cache_only_plus1,
+			stats.highest_referenced_plus1, stats.cache_only_clusters);
 	mutex_unlock(&si->xswap_lock);
 
 	return simple_read_from_buffer(buf, count, ppos, tmp, len);
-- 
