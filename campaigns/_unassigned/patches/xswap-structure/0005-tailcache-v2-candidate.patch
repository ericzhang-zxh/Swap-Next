 #define XSWAP_SHRINK_SLACK	XSWAP_GROW_CLUSTERS
 #define XSWAP_SHRINK_MIN	(XSWAP_GROW_CLUSTERS * 8)
 
+/*
+ * Try cache-only blockers in a bounded tail window. A referenced or busy
+ * cluster ends this pass; the ordinary shrink still decides what to unmap.
+ */
+static void xswap_reclaim_tail_cache(struct swap_info_struct *si,
+				     unsigned long mapped)
+{
+	unsigned long nr_scan = min(mapped - 1,
+				    XSWAP_SHRINK_MIN + XSWAP_SHRINK_SLACK);
+	struct swap_cluster_info *ci;
+	unsigned int off;
+	unsigned long entry;
+	int ret;
+
+	lockdep_assert_held(&si->xswap_lock);
+	while (nr_scan--) {
+		if (!(READ_ONCE(si->flags) & SWP_WRITEOK))
+			return;
+		ci = &si->cluster_info[--mapped];
+		spin_lock(&ci->lock);
+		if (!ci->count && ci->flags == CLUSTER_FLAG_FREE)
+			goto next_cluster;
+		if (!ci->count || !cluster_table_is_alloced(ci))
+			goto out_unlock;
+
+		/* Leave clusters with live swap references alone. */
+		for (off = 0; off < SWAPFILE_CLUSTER; off++) {
+			entry = __swap_table_get(ci, off);
+			if (!swp_tb_is_null(entry) &&
+			    (!swp_tb_is_folio(entry) || swp_tb_get_count(entry)))
+				goto out_unlock;
+		}
+
+		for (off = 0; off < SWAPFILE_CLUSTER; off++) {
+			entry = __swap_table_get(ci, off);
+			if (swp_tb_is_null(entry))
+				continue;
+			if (!swp_tb_is_folio(entry) || swp_tb_get_count(entry))
+				goto out_unlock;
+
+			/* The helper takes its own folio and cluster locks. */
+			rcu_read_lock();
+			spin_unlock(&ci->lock);
+			ret = __try_to_reclaim_swap(si,
+					mapped * SWAPFILE_CLUSTER + off, TTRS_ANYWAY);
+			spin_lock(&ci->lock);
+			rcu_read_unlock();
+			if (!ci->count && ci->flags == CLUSTER_FLAG_FREE)
+				goto next_cluster;
+			if (!ci->count || !cluster_table_is_alloced(ci))
+				goto out_unlock;
+			/* A failed attempt may have raced a successful free. */
+			if (ret <= 0 && !swp_tb_is_null(__swap_table_get(ci, off)))
+				goto out_unlock;
+		}
+		/* A concurrent allocation may have filled an earlier slot. */
+		if (ci->count || ci->flags != CLUSTER_FLAG_FREE)
+			goto out_unlock;
+next_cluster:
+		spin_unlock(&ci->lock);
+		cond_resched();
+	}
+	return;
+
+out_unlock:
+	spin_unlock(&ci->lock);
+}
