diff --git a/mm/page_compress.c b/mm/page_compress.c
new file mode 100644
index 000000000..368cdeeb2
--- /dev/null
+++ b/mm/page_compress.c
@@ -0,0 +1,396 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Page compression and object storage, extracted from zswap.
+ * Copyright (C) 2012 Seth Jennings <sjenning@linux.vnet.ibm.com>
+ */
+
+#include <linux/cpu.h>
+#include <linux/highmem.h>
+#include <linux/init.h>
+#include <linux/mutex.h>
+#include <linux/page_compress.h>
+#include <linux/percpu.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/zsmalloc.h>
+#include <crypto/acompress.h>
+#include <crypto/scatterwalk.h>
+#include <kunit/static_stub.h>
+
+struct page_compress_ctx {
+	struct crypto_acomp *acomp;
+	struct acomp_req *req;
+	struct crypto_wait wait;
+	u8 *buffer;
+	/* Serializes the scratch buffer and the synchronous crypto request. */
+	struct mutex mutex;
+};
+
+struct page_compress_pool {
+	struct zs_pool *zs_pool;
+	struct page_compress_ctx __percpu *ctx;
+	struct hlist_node node;
+	char codec[CRYPTO_MAX_ALG_NAME];
+};
+
+static int page_compress_init_error = -EAGAIN;
+
+/* Leaf boundaries keep fault injection local to the invoking KUnit task. */
+static struct page_compress_pool *pc_pool_alloc(void)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_pool_alloc);
+	return kzalloc_obj(struct page_compress_pool);
+}
+
+static void pc_pool_free(struct page_compress_pool *pool)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_pool_free, pool);
+	kfree(pool);
+}
+
+static struct zs_pool *pc_zs_create(const char *name)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_zs_create, name);
+	return zs_create_pool(name);
+}
+
+static void pc_zs_destroy(struct zs_pool *pool)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_zs_destroy, pool);
+	zs_destroy_pool(pool);
+}
+
+static struct page_compress_ctx __percpu *pc_percpu_alloc(void)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_percpu_alloc);
+	return alloc_percpu_gfp(struct page_compress_ctx,
+				GFP_KERNEL | __GFP_ZERO);
+}
+
+static void pc_percpu_free(struct page_compress_ctx __percpu *ctx)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_percpu_free, ctx);
+	free_percpu(ctx);
+}
+
+static u8 *pc_buffer_alloc(int nid)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_buffer_alloc, nid);
+	return kmalloc_node(PAGE_SIZE, GFP_KERNEL, nid);
+}
+
+static void pc_buffer_free(u8 *buffer)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_buffer_free, buffer);
+	kfree(buffer);
+}
+
+static struct crypto_acomp *pc_acomp_alloc(const char *codec, int nid)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_acomp_alloc, codec, nid);
+	return crypto_alloc_acomp_node(codec, 0, 0, nid);
+}
+
+static void pc_acomp_free(struct crypto_acomp *acomp)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_acomp_free, acomp);
+	crypto_free_acomp(acomp);
+}
+
+static struct acomp_req *pc_request_alloc(struct crypto_acomp *acomp)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_request_alloc, acomp);
+	return acomp_request_alloc(acomp);
+}
+
+static void pc_request_free(struct acomp_req *req)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_request_free, req);
+	acomp_request_free(req);
+}
+
+static unsigned long pc_object_alloc(struct zs_pool *pool, unsigned int length,
+				     gfp_t gfp, int nid)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_object_alloc, pool, length, gfp, nid);
+	return zs_malloc(pool, length, gfp, nid);
+}
+
+static void pc_object_free(struct zs_pool *pool, unsigned long handle)
+{
+	if (IS_ENABLED(CONFIG_PAGE_COMPRESS_KUNIT_TEST))
+		KUNIT_STATIC_STUB_REDIRECT(pc_object_free, pool, handle);
+	zs_free(pool, handle);
+}
+
+static void page_compress_ctx_free(struct page_compress_ctx *ctx)
+{
+	if (ctx->req)
+		pc_request_free(ctx->req);
+	ctx->req = NULL;
+
+	/* A failed codec allocation leaves an ERR_PTR until this cleanup. */
+	if (!IS_ERR_OR_NULL(ctx->acomp))
+		pc_acomp_free(ctx->acomp);
+	ctx->acomp = NULL;
+
+	if (ctx->buffer)
+		pc_buffer_free(ctx->buffer);
+	ctx->buffer = NULL;
+}
+
+static int page_compress_cpu_prepare(unsigned int cpu, struct hlist_node *node)
+{
+	struct page_compress_pool *pool;
+	struct page_compress_ctx *ctx;
+	int ret = -ENOMEM;
+
+	pool = hlist_entry(node, struct page_compress_pool, node);
+	ctx = per_cpu_ptr(pool->ctx, cpu);
+
+	/* Contexts survive online-offline-online transitions until pool death. */
+	if (ctx->acomp) {
+		WARN_ON_ONCE(IS_ERR(ctx->acomp));
+		return 0;
+	}
+
+	ctx->buffer = pc_buffer_alloc(cpu_to_node(cpu));
+	if (!ctx->buffer)
+		return ret;
+
+	ctx->acomp = pc_acomp_alloc(pool->codec, cpu_to_node(cpu));
+	if (IS_ERR(ctx->acomp)) {
+		ret = PTR_ERR(ctx->acomp);
+		goto fail;
+	}
+
+	ctx->req = pc_request_alloc(ctx->acomp);
+	if (!ctx->req)
+		goto fail;
+
+	crypto_init_wait(&ctx->wait);
+	acomp_request_set_callback(ctx->req, CRYPTO_TFM_REQ_MAY_BACKLOG,
+				   crypto_req_done, &ctx->wait);
+	mutex_init(&ctx->mutex);
+	return 0;
+
+fail:
+	page_compress_ctx_free(ctx);
+	return ret;
+}
+
+struct page_compress_pool *page_compress_create(const char *codec,
+						const char *name)
+{
+	struct page_compress_pool *pool;
+	int cpu, ret = -ENOMEM;
+
+	if (page_compress_init_error)
+		return ERR_PTR(page_compress_init_error);
+
+	pool = pc_pool_alloc();
+	if (!pool)
+		return ERR_PTR(-ENOMEM);
+
+	ret = strscpy(pool->codec, codec, sizeof(pool->codec));
+	if (ret < 0)
+		goto free_pool;
+
+	ret = -ENOMEM;
+	pool->zs_pool = pc_zs_create(name);
+	if (!pool->zs_pool)
+		goto free_pool;
+
+	pool->ctx = pc_percpu_alloc();
+	if (!pool->ctx)
+		goto destroy_zs;
+
+	ret = cpuhp_state_add_instance(CPUHP_MM_PAGE_COMPRESS_PREPARE,
+				       &pool->node);
+	if (ret)
+		goto free_contexts;
+
+	return pool;
+
+free_contexts:
+	/* No teardown callback: failed add-instance needs explicit rollback. */
+	for_each_possible_cpu(cpu)
+		page_compress_ctx_free(per_cpu_ptr(pool->ctx, cpu));
+	pc_percpu_free(pool->ctx);
+destroy_zs:
+	pc_zs_destroy(pool->zs_pool);
+free_pool:
+	pc_pool_free(pool);
+	return ERR_PTR(ret);
+}
+
+void page_compress_destroy(struct page_compress_pool *pool)
+{
+	int cpu;
+
+	cpuhp_state_remove_instance(CPUHP_MM_PAGE_COMPRESS_PREPARE, &pool->node);
+	for_each_possible_cpu(cpu)
+		page_compress_ctx_free(per_cpu_ptr(pool->ctx, cpu));
+	pc_percpu_free(pool->ctx);
+	pc_zs_destroy(pool->zs_pool);
+	pc_pool_free(pool);
+}
+
+const char *page_compress_codec(struct page_compress_pool *pool)
+{
+	return pool->codec;
+}
+
+int page_compress_store(struct page_compress_pool *pool, struct folio *folio,
+			long index, gfp_t gfp, int nid,
+			struct page_compress_result *result)
+{
+	struct page_compress_ctx *ctx;
+	struct scatterlist input, output;
+	unsigned int dlen;
+	unsigned long handle;
+	u8 *dst;
+	int ret;
+
+	*result = (struct page_compress_result) {
+		.failure = PAGE_COMPRESS_CODEC,
+	};
+	if (index < 0 || index >= folio_nr_pages(folio))
+		return -EINVAL;
+
+	ctx = raw_cpu_ptr(pool->ctx);
+	mutex_lock(&ctx->mutex);
+
+	dst = ctx->buffer;
+	sg_init_table(&input, 1);
+	sg_set_folio(&input, folio, PAGE_SIZE, index * PAGE_SIZE);
+	sg_init_one(&output, dst, PAGE_SIZE);
+	acomp_request_set_params(ctx->req, &input, &output, PAGE_SIZE, PAGE_SIZE);
+
+	/* The frontend is synchronous even when the codec completes async. */
+	ret = crypto_wait_req(crypto_acomp_compress(ctx->req), &ctx->wait);
+	dlen = ctx->req->dlen;
+	if (ret || !dlen || dlen >= PAGE_SIZE) {
+		ret = ret ? ret : -EINVAL;
+		goto unlock;
+	}
+
+	handle = pc_object_alloc(pool->zs_pool, dlen, gfp, nid);
+	if (IS_ERR_VALUE(handle)) {
+		result->failure = PAGE_COMPRESS_ALLOC;
+		ret = PTR_ERR((void *)handle);
+		goto unlock;
+	}
+
+	zs_obj_write(pool->zs_pool, handle, dst, dlen);
+	result->handle = handle;
+	result->length = dlen;
+	result->failure = PAGE_COMPRESS_NONE;
+	ret = 0;
+unlock:
+	mutex_unlock(&ctx->mutex);
+	return ret;
+}
+
+int page_compress_store_raw(struct page_compress_pool *pool, struct folio *folio,
+			    long index, gfp_t gfp, int nid,
+			    struct page_compress_result *result)
+{
+	unsigned long handle;
+	void *src;
+
+	*result = (struct page_compress_result) {
+		.failure = PAGE_COMPRESS_ALLOC,
+	};
+	if (index < 0 || index >= folio_nr_pages(folio))
+		return -EINVAL;
+
+	handle = pc_object_alloc(pool->zs_pool, PAGE_SIZE, gfp, nid);
+	if (IS_ERR_VALUE(handle))
+		return PTR_ERR((void *)handle);
+
+	src = kmap_local_folio(folio, index * PAGE_SIZE);
+	zs_obj_write(pool->zs_pool, handle, src, PAGE_SIZE);
+	kunmap_local(src);
+	result->handle = handle;
+	result->length = PAGE_SIZE;
+	result->failure = PAGE_COMPRESS_NONE;
+	return 0;
+}
+
+int page_compress_load(struct page_compress_pool *pool, unsigned long handle,
+		       unsigned int length, struct folio *folio, long index)
+{
+	struct scatterlist input[2], output;
+	struct page_compress_ctx *ctx;
+	unsigned int dlen;
+	int ret = 0;
+
+	if (!handle || IS_ERR_VALUE(handle) || !length || length > PAGE_SIZE ||
+	    index < 0 || index >= folio_nr_pages(folio))
+		return -EINVAL;
+
+	ctx = raw_cpu_ptr(pool->ctx);
+	mutex_lock(&ctx->mutex);
+	zs_obj_read_sg_begin(pool->zs_pool, handle, input, length);
+
+	if (length == PAGE_SIZE) {
+		void *dst;
+
+		WARN_ON_ONCE(input->length != PAGE_SIZE);
+		dst = kmap_local_folio(folio, index * PAGE_SIZE);
+		memcpy_from_sglist(dst, input, 0, PAGE_SIZE);
+		dlen = PAGE_SIZE;
+		kunmap_local(dst);
+		flush_dcache_folio(folio);
+	} else {
+		sg_init_table(&output, 1);
+		sg_set_folio(&output, folio, PAGE_SIZE, index * PAGE_SIZE);
+		acomp_request_set_params(ctx->req, input, &output, length,
+					 PAGE_SIZE);
+		ret = crypto_wait_req(crypto_acomp_decompress(ctx->req), &ctx->wait);
+		dlen = ctx->req->dlen;
+	}
+
+	zs_obj_read_sg_end(pool->zs_pool, handle);
+	mutex_unlock(&ctx->mutex);
+	return ret ? ret : (dlen == PAGE_SIZE ? 0 : -EINVAL);
+}
+
+void page_compress_free(struct page_compress_pool *pool, unsigned long handle)
+{
+	pc_object_free(pool->zs_pool, handle);
+}
+
+unsigned long page_compress_backing_pages(struct page_compress_pool *pool)
+{
+	return zs_get_total_pages(pool->zs_pool);
+}
+
+static int __init page_compress_init(void)
+{
+	/* Registration allocates no codecs; clients create pools after crypto. */
+	page_compress_init_error =
+		cpuhp_setup_state_multi(CPUHP_MM_PAGE_COMPRESS_PREPARE,
+					"mm/page_compress:prepare",
+					page_compress_cpu_prepare, NULL);
+	return page_compress_init_error;
+}
+subsys_initcall(page_compress_init);
+
+#if IS_BUILTIN(CONFIG_PAGE_COMPRESS_KUNIT_TEST)
+#include "page_compress_test.c"
+#endif
diff --git a/mm/page_compress_test.c b/mm/page_compress_test.c
new file mode 100644
index 000000000..68d00f549
--- /dev/null
+++ b/mm/page_compress_test.c
@@ -0,0 +1,560 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Included by page_compress.c to keep test hooks out of the public interface. */
+#include <kunit/test.h>
+#include <linux/delay.h>
+#include <linux/nodemask.h>
+
+#define PC_TEST_GFP (GFP_NOWAIT | __GFP_NORETRY | __GFP_HIGHMEM | __GFP_MOVABLE)
+
+enum pc_test_site {
+	PC_TEST_POOL,
+	PC_TEST_ZS,
+	PC_TEST_PERCPU,
+	PC_TEST_BUFFER,
+	PC_TEST_ACOMP,
+	PC_TEST_REQUEST,
+	PC_TEST_OBJECT,
+	PC_TEST_SITES,
+};
+
+struct pc_test_state {
+	struct page_compress_pool *pool;
+	struct page_compress_result objects[3];
+	struct folio *source;
+	struct folio *destination;
+	unsigned int calls[PC_TEST_SITES];
+	unsigned int allocated[PC_TEST_SITES];
+	unsigned int released[PC_TEST_SITES];
+	enum pc_test_site fail_site;
+	unsigned int fail_call;
+	unsigned int failures;
+};
+
+static struct pc_test_state *pc_test_state(void)
+{
+	return kunit_get_current_test()->priv;
+}
+
+static bool pc_test_fail(enum pc_test_site site)
+{
+	struct pc_test_state *state = pc_test_state();
+
+	state->calls[site]++;
+	if (state->fail_site != site || state->calls[site] != state->fail_call)
+		return false;
+	state->failures++;
+	return true;
+}
+
+static void pc_test_allocated(enum pc_test_site site, bool allocated)
+{
+	if (allocated)
+		pc_test_state()->allocated[site]++;
+}
+
+static struct page_compress_pool *pc_test_pool_alloc(void)
+{
+	struct page_compress_pool *pool;
+
+	if (pc_test_fail(PC_TEST_POOL))
+		return NULL;
+	pool = kzalloc_obj(*pool);
+	pc_test_allocated(PC_TEST_POOL, pool);
+	return pool;
+}
+
+static void pc_test_pool_free(struct page_compress_pool *pool)
+{
+	pc_test_state()->released[PC_TEST_POOL]++;
+	kfree(pool);
+}
+
+static struct zs_pool *pc_test_zs_create(const char *name)
+{
+	struct zs_pool *pool;
+
+	if (pc_test_fail(PC_TEST_ZS))
+		return NULL;
+	pool = zs_create_pool(name);
+	pc_test_allocated(PC_TEST_ZS, pool);
+	return pool;
+}
+
+static void pc_test_zs_destroy(struct zs_pool *pool)
+{
+	pc_test_state()->released[PC_TEST_ZS]++;
+	zs_destroy_pool(pool);
+}
+
+static struct page_compress_ctx __percpu *pc_test_percpu_alloc(void)
+{
+	struct page_compress_ctx __percpu *ctx;
+
+	if (pc_test_fail(PC_TEST_PERCPU))
+		return NULL;
+	ctx = alloc_percpu_gfp(struct page_compress_ctx, GFP_KERNEL | __GFP_ZERO);
+	pc_test_allocated(PC_TEST_PERCPU, ctx);
+	return ctx;
+}
+
+static void pc_test_percpu_free(struct page_compress_ctx __percpu *ctx)
+{
+	pc_test_state()->released[PC_TEST_PERCPU]++;
+	free_percpu(ctx);
+}
+
+static u8 *pc_test_buffer_alloc(int nid)
+{
+	u8 *buffer;
+
+	if (pc_test_fail(PC_TEST_BUFFER))
+		return NULL;
+	buffer = kmalloc_node(PAGE_SIZE, GFP_KERNEL, nid);
+	pc_test_allocated(PC_TEST_BUFFER, buffer);
+	return buffer;
+}
+
+static void pc_test_buffer_free(u8 *buffer)
+{
+	pc_test_state()->released[PC_TEST_BUFFER]++;
+	kfree(buffer);
+}
+
+static struct crypto_acomp *pc_test_acomp_alloc(const char *codec, int nid)
+{
+	struct crypto_acomp *acomp;
+
+	if (pc_test_fail(PC_TEST_ACOMP))
+		return ERR_PTR(-ENOMEM);
+	acomp = crypto_alloc_acomp_node(codec, 0, 0, nid);
+	pc_test_allocated(PC_TEST_ACOMP, !IS_ERR(acomp));
+	return acomp;
+}
+
+static void pc_test_acomp_free(struct crypto_acomp *acomp)
+{
+	pc_test_state()->released[PC_TEST_ACOMP]++;
+	crypto_free_acomp(acomp);
+}
+
+static struct acomp_req *pc_test_request_alloc(struct crypto_acomp *acomp)
+{
+	struct acomp_req *req;
+
+	if (pc_test_fail(PC_TEST_REQUEST))
+		return NULL;
+	req = acomp_request_alloc(acomp);
+	pc_test_allocated(PC_TEST_REQUEST, req);
+	return req;
+}
+
+static void pc_test_request_free(struct acomp_req *req)
+{
+	pc_test_state()->released[PC_TEST_REQUEST]++;
+	acomp_request_free(req);
+}
+
+static unsigned long pc_test_object_alloc(struct zs_pool *pool,
+					  unsigned int length, gfp_t gfp, int nid)
+{
+	unsigned long handle;
+
+	if (pc_test_fail(PC_TEST_OBJECT))
+		return (unsigned long)ERR_PTR(-ENOMEM);
+	handle = zs_malloc(pool, length, gfp, nid);
+	pc_test_allocated(PC_TEST_OBJECT, !IS_ERR_VALUE(handle));
+	return handle;
+}
+
+static void pc_test_object_free(struct zs_pool *pool, unsigned long handle)
+{
+	pc_test_state()->released[PC_TEST_OBJECT]++;
+	zs_free(pool, handle);
+}
+
+static void pc_test_free_objects(struct pc_test_state *state)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(state->objects); i++) {
+		if (!state->objects[i].handle)
+			continue;
+		page_compress_free(state->pool, state->objects[i].handle);
+		state->objects[i] = (struct page_compress_result) {};
+	}
+}
+
+static void pc_test_close_pool(struct pc_test_state *state)
+{
+	if (!state->pool)
+		return;
+	pc_test_free_objects(state);
+	page_compress_destroy(state->pool);
+	state->pool = NULL;
+}
+
+static void pc_test_cleanup(void *data)
+{
+	struct pc_test_state *state = data;
+
+	state->fail_site = PC_TEST_SITES;
+	pc_test_close_pool(state);
+	if (state->source)
+		folio_put(state->source);
+	if (state->destination)
+		folio_put(state->destination);
+}
+
+static int pc_test_init(struct kunit *test)
+{
+	struct pc_test_state *state;
+	int ret;
+
+	state = kunit_kzalloc(test, sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	test->priv = state;
+	state->fail_site = PC_TEST_SITES;
+
+	kunit_activate_static_stub(test, pc_pool_alloc, pc_test_pool_alloc);
+	kunit_activate_static_stub(test, pc_pool_free, pc_test_pool_free);
+	kunit_activate_static_stub(test, pc_zs_create, pc_test_zs_create);
+	kunit_activate_static_stub(test, pc_zs_destroy, pc_test_zs_destroy);
+	kunit_activate_static_stub(test, pc_percpu_alloc, pc_test_percpu_alloc);
+	kunit_activate_static_stub(test, pc_percpu_free, pc_test_percpu_free);
+	kunit_activate_static_stub(test, pc_buffer_alloc, pc_test_buffer_alloc);
+	kunit_activate_static_stub(test, pc_buffer_free, pc_test_buffer_free);
+	kunit_activate_static_stub(test, pc_acomp_alloc, pc_test_acomp_alloc);
+	kunit_activate_static_stub(test, pc_acomp_free, pc_test_acomp_free);
+	kunit_activate_static_stub(test, pc_request_alloc, pc_test_request_alloc);
+	kunit_activate_static_stub(test, pc_request_free, pc_test_request_free);
+	kunit_activate_static_stub(test, pc_object_alloc, pc_test_object_alloc);
+	kunit_activate_static_stub(test, pc_object_free, pc_test_object_free);
+
+	/* LIFO cleanup runs while both the state and static stubs still exist. */
+	ret = kunit_add_action_or_reset(test, pc_test_cleanup, state);
+	if (ret)
+		return ret;
+	state->source = folio_alloc(GFP_KERNEL, 0);
+	state->destination = folio_alloc(GFP_KERNEL, 0);
+	if (!state->source || !state->destination)
+		return -ENOMEM;
+	return 0;
+}
+
+static void pc_test_arm(struct pc_test_state *state, enum pc_test_site site,
+			unsigned int nth)
+{
+	state->fail_site = site;
+	state->fail_call = state->calls[site] + nth;
+	state->failures = 0;
+}
+
+static void pc_test_balanced(struct kunit *test)
+{
+	struct pc_test_state *state = test->priv;
+	int site;
+
+	for (site = 0; site < PC_TEST_SITES; site++)
+		KUNIT_EXPECT_EQ_MSG(test, state->allocated[site],
+				    state->released[site], "resource site %d", site);
+}
+
+static void pc_test_open_pool(struct kunit *test)
+{
+	struct pc_test_state *state = test->priv;
+	struct page_compress_pool *pool;
+
+	pool = page_compress_create("lzo", "page_compress_kunit");
+	if (!IS_ERR_OR_NULL(pool))
+		state->pool = pool;
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, pool);
+}
+
+static u64 pc_test_word(unsigned int generation, unsigned int word)
+{
+	return ((u64)(generation + 1) << 32) | (word % 8 + 1);
+}
+
+static void pc_test_fill(struct folio *folio, unsigned int generation)
+{
+	u64 *words = kmap_local_folio(folio, 0);
+	unsigned int i;
+
+	for (i = 0; i < PAGE_SIZE / sizeof(*words); i++)
+		words[i] = pc_test_word(generation, i);
+	kunmap_local(words);
+	flush_dcache_folio(folio);
+}
+
+static void pc_test_store(struct kunit *test, unsigned int slot, int nid)
+{
+	struct pc_test_state *state = test->priv;
+	struct page_compress_result *result = &state->objects[slot];
+	int ret;
+
+	pc_test_fill(state->source, slot);
+	ret = page_compress_store(state->pool, state->source, 0, PC_TEST_GFP,
+				  nid, result);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_NE(test, result->handle, 0UL);
+	KUNIT_ASSERT_GT(test, result->length, 0U);
+	KUNIT_ASSERT_LT(test, result->length, (unsigned int)PAGE_SIZE);
+	KUNIT_EXPECT_EQ(test, result->failure, PAGE_COMPRESS_NONE);
+}
+
+static void pc_test_verify(struct kunit *test, unsigned int slot)
+{
+	struct pc_test_state *state = test->priv;
+	struct page_compress_result *result = &state->objects[slot];
+	unsigned int i, bad = 0;
+	u64 *words;
+	int ret;
+
+	pc_test_fill(state->destination, slot + 100);
+	ret = page_compress_load(state->pool, result->handle, result->length,
+				 state->destination, 0);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	words = kmap_local_folio(state->destination, 0);
+	for (i = 0; i < PAGE_SIZE / sizeof(*words); i++)
+		bad += words[i] != pc_test_word(slot, i);
+	kunmap_local(words);
+	KUNIT_EXPECT_EQ(test, bad, 0U);
+}
+
+static void pc_test_empty(struct kunit *test)
+{
+	struct pc_test_state *state = test->priv;
+	int i;
+
+	/* zsmalloc may defer freeing an empty zspage while migration holds it. */
+	for (i = 0; i < 100 && page_compress_backing_pages(state->pool); i++)
+		usleep_range(1000, 2000);
+	KUNIT_EXPECT_EQ(test, page_compress_backing_pages(state->pool), 0UL);
+}
+
+static void pc_test_roundtrip(struct kunit *test)
+{
+	struct pc_test_state *state = test->priv;
+
+	pc_test_open_pool(test);
+	pc_test_store(test, 0, NUMA_NO_NODE);
+	pc_test_verify(test, 0);
+	pc_test_free_objects(state);
+	pc_test_empty(test);
+	pc_test_close_pool(state);
+	pc_test_balanced(test);
+}
+
+static void pc_test_create_failure(struct kunit *test, enum pc_test_site site,
+				   unsigned int nth)
+{
+	struct pc_test_state *state = test->priv;
+	struct page_compress_pool *pool;
+
+	pc_test_arm(state, site, nth);
+	pool = page_compress_create("lzo", "page_compress_kunit");
+	state->fail_site = PC_TEST_SITES;
+	if (!IS_ERR_OR_NULL(pool))
+		state->pool = pool;
+	KUNIT_ASSERT_TRUE(test, IS_ERR(pool));
+	KUNIT_EXPECT_EQ(test, PTR_ERR(pool), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, state->failures, 1U);
+	pc_test_balanced(test);
+	kunit_info(test, "allocation failure site=%u nth=%u observed=%u\n",
+		   site, nth, state->failures);
+	pc_test_roundtrip(test);
+}
+
+static void pc_test_store_failure(struct kunit *test, unsigned int slot)
+{
+	struct pc_test_state *state = test->priv;
+	struct page_compress_result *result = &state->objects[slot];
+	unsigned long before = page_compress_backing_pages(state->pool);
+	int ret;
+
+	pc_test_fill(state->source, slot);
+	pc_test_arm(state, PC_TEST_OBJECT, 1);
+	ret = page_compress_store(state->pool, state->source, 0, PC_TEST_GFP,
+				  NUMA_NO_NODE, result);
+	state->fail_site = PC_TEST_SITES;
+	KUNIT_EXPECT_EQ(test, ret, -ENOMEM);
+	KUNIT_EXPECT_EQ(test, state->failures, 1U);
+	KUNIT_EXPECT_EQ(test, result->failure, PAGE_COMPRESS_ALLOC);
+	KUNIT_EXPECT_EQ(test, result->handle, 0UL);
+	KUNIT_EXPECT_EQ(test, result->length, 0U);
+	KUNIT_EXPECT_EQ(test, page_compress_backing_pages(state->pool), before);
+	kunit_info(test, "object failure slot=%u observed=%u backing=%lu\n",
+		   slot, state->failures, before);
+}
+
+static void pc_test_raw_verify(struct kunit *test)
+{
+	struct pc_test_state *state = test->priv;
+	struct page_compress_result *result = &state->objects[0];
+	void *source, *destination;
+	int ret;
+
+	ret = page_compress_load(state->pool, result->handle, result->length,
+				 state->destination, 0);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	source = kmap_local_folio(state->source, 0);
+	destination = kmap_local_folio(state->destination, 0);
+	ret = memcmp(source, destination, PAGE_SIZE);
+	kunmap_local(destination);
+	kunmap_local(source);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+}
+
+static void pc_test_raw_roundtrip(struct kunit *test)
+{
+	struct pc_test_state *state = test->priv;
+	struct page_compress_result *result = &state->objects[0];
+	u64 *words, value = 0xbadc0ffee1234567ULL;
+	unsigned int i;
+	int ret;
+
+	pc_test_open_pool(test);
+	words = kmap_local_folio(state->source, 0);
+	for (i = 0; i < PAGE_SIZE / sizeof(*words); i++) {
+		value ^= value << 13;
+		value ^= value >> 7;
+		value ^= value << 17;
+		words[i] = value;
+	}
+	kunmap_local(words);
+	flush_dcache_folio(state->source);
+
+	ret = page_compress_store(state->pool, state->source, 0, PC_TEST_GFP,
+				  NUMA_NO_NODE, result);
+	KUNIT_ASSERT_NE(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, result->failure, PAGE_COMPRESS_CODEC);
+	KUNIT_EXPECT_EQ(test, result->handle, 0UL);
+	KUNIT_EXPECT_EQ(test, result->length, 0U);
+
+	ret = page_compress_store_raw(state->pool, state->source, 0, PC_TEST_GFP,
+				      NUMA_NO_NODE, result);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, result->length, (unsigned int)PAGE_SIZE);
+	pc_test_raw_verify(test);
+
+	result = &state->objects[1];
+	pc_test_arm(state, PC_TEST_OBJECT, 1);
+	ret = page_compress_store_raw(state->pool, state->source, 0, PC_TEST_GFP,
+				      NUMA_NO_NODE, result);
+	state->fail_site = PC_TEST_SITES;
+	KUNIT_EXPECT_EQ(test, ret, -ENOMEM);
+	KUNIT_EXPECT_EQ(test, state->failures, 1U);
+	KUNIT_EXPECT_EQ(test, result->failure, PAGE_COMPRESS_ALLOC);
+	KUNIT_EXPECT_EQ(test, result->handle, 0UL);
+	pc_test_raw_verify(test);
+	pc_test_free_objects(state);
+	pc_test_empty(test);
+	pc_test_close_pool(state);
+	pc_test_balanced(test);
+}
+
+static void page_compress_alloc_rollback(struct kunit *test)
+{
+	struct pc_test_state *state = test->priv;
+	int site;
+
+	for (site = PC_TEST_POOL; site <= PC_TEST_REQUEST; site++)
+		pc_test_create_failure(test, site, 1);
+	/* The fixed PREPARE state invokes these callbacks in this test task. */
+	if (num_online_cpus() > 1)
+		pc_test_create_failure(test, PC_TEST_REQUEST, 2);
+
+	pc_test_open_pool(test);
+	pc_test_store(test, 0, NUMA_NO_NODE);
+	pc_test_store_failure(test, 1);
+	pc_test_verify(test, 0);
+	pc_test_store(test, 1, NUMA_NO_NODE);
+	pc_test_verify(test, 1);
+	pc_test_free_objects(state);
+	pc_test_empty(test);
+	pc_test_close_pool(state);
+	pc_test_balanced(test);
+	pc_test_raw_roundtrip(test);
+}
+
+static void page_compress_partial_cleanup(struct kunit *test)
+{
+	struct pc_test_state *state = test->priv;
+
+	pc_test_open_pool(test);
+	pc_test_store(test, 0, NUMA_NO_NODE);
+	pc_test_store(test, 1, NUMA_NO_NODE);
+	pc_test_store_failure(test, 2);
+	pc_test_verify(test, 0);
+	pc_test_verify(test, 1);
+	pc_test_free_objects(state);
+	pc_test_empty(test);
+
+	pc_test_store(test, 2, NUMA_NO_NODE);
+	pc_test_verify(test, 2);
+	pc_test_free_objects(state);
+	pc_test_empty(test);
+	pc_test_close_pool(state);
+	pc_test_balanced(test);
+}
+
+static void page_compress_numa_placement(struct kunit *test)
+{
+	struct pc_test_state *state = test->priv;
+	unsigned int nodes = 0, placements = 0, mismatches = 0;
+	struct page_compress_result *result = &state->objects[0];
+	struct scatterlist input[2], *sg;
+	int nid, actual[2], count, i;
+
+	for_each_online_node(nid) {
+		if (!node_state(nid, N_MEMORY))
+			continue;
+
+		/* An existing size-class page can bypass the requested allocation nid. */
+		pc_test_open_pool(test);
+		pc_test_store(test, 0, nid);
+		zs_obj_read_sg_begin(state->pool->zs_pool, result->handle,
+				     input, result->length);
+		count = 0;
+		for (sg = input; sg; sg = sg_next(sg))
+			actual[count++] = page_to_nid(sg_page(sg));
+		zs_obj_read_sg_end(state->pool->zs_pool, result->handle);
+
+		KUNIT_ASSERT_GT(test, count, 0);
+		for (i = 0; i < count; i++) {
+			mismatches += actual[i] != nid;
+			KUNIT_EXPECT_EQ(test, actual[i], nid);
+			kunit_info(test,
+				   "PAGE_COMPRESS_NUMA requested=%d actual=%d pages=1\n",
+				   nid, actual[i]);
+			placements++;
+		}
+		nodes++;
+		pc_test_verify(test, 0);
+		pc_test_free_objects(state);
+		pc_test_empty(test);
+		pc_test_close_pool(state);
+	}
+	KUNIT_EXPECT_GT(test, nodes, 0U);
+	KUNIT_EXPECT_EQ(test, mismatches, 0U);
+	pc_test_balanced(test);
+	kunit_info(test,
+		   "PAGE_COMPRESS_NUMA_TOTAL nodes=%u placements=%u mismatches=%u\n",
+		   nodes, placements, mismatches);
+}
+
+static struct kunit_case page_compress_cases[] = {
+	KUNIT_CASE(page_compress_alloc_rollback),
+	KUNIT_CASE(page_compress_partial_cleanup),
+	KUNIT_CASE(page_compress_numa_placement),
+	{}
+};
+
+static struct kunit_suite page_compress_suite = {
+	.name = "page_compress",
+	.init = pc_test_init,
+	.test_cases = page_compress_cases,
+};
+
+kunit_test_suite(page_compress_suite);
