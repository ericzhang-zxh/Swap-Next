      "id": "results",
      "title": "What the run established",
      "blocks": [
        {
          "type": "note",
          "text": "The trace reader completed without truncation. The observer requires exactly one decode per timed page, so the workload stopped before collecting usable measurements. The trace does not identify the addresses of the two pages."
        },
        {
          "type": "bars",
          "takeaway": "The observation contained an extra decoder return",
          "categories": [
            "First timed page"
          ],
          "series": [
            "Required",
