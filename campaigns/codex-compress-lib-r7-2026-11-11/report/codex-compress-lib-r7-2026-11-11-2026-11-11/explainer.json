  "sections": [
    {
      "id": "context",
      "title": "Why time compressed swap",
      "lead": "A memory page can be stored as a smaller compressed copy. Restoring it takes work, so the experiment measures how long the application waits.",
      "blocks": [
        {
          "type": "note",
          "text": "The shared library moves compression and storage code behind one interface. The experiment tests whether existing behavior survives the change."
        }
      ]
