    {
      "id": "changes",
      "title": "Keep the timing tool resident",
      "lead": "The original trace identified the process. It did not record a page address for either return. The repair keeps the tool's non-target mappings resident and leaves the test region available to swap.",
      "blocks": [
        {
          "type": "flow",
          "nodes": [
            {
              "id": "front",
