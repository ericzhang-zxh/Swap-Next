{
  "title": "Isolating the compressed swap timing tool",
  "subtitle": "A trace-driven repair and matched diagnostic runs.",
  "verdict": {
    "status": "inconclusive",
    "headline": "Both kernels completed the compressed-swap diagnostic with exactly one verified decompression for every timed page. The shared library also passed the functional rerun.",
    "tiles": [
      {
        "label": "Function",
        "value": "Checks passed",
        "note": "Data, concurrency and cleanup passed again."
      },
      {
        "label": "Observer",
        "value": "Both kernels passed",
        "note": "Every timed read had one verified return."
      },
      {
        "label": "Performance",
        "value": "Unmeasured",
        "note": "Repeated calibration and comparison are pending."
      }
    ],
    "label": "Observer repair verified"
  },
  "sections": [
    {
      "id": "context",
      "title": "Why time compressed swap",
      "lead": "A memory page can be stored as a smaller compressed copy. Restoring it takes work, so the experiment measures how long the application waits.",
      "blocks": [
        {
          "type": "note",
          "text": "The shared library moves compression and storage code behind one interface. The experiment tests whether existing behavior survives the change."
        }
      ]
    },
    {
      "id": "system",
      "title": "Where compressed swap operates",
      "lead": "An application reads a page that is no longer resident in working memory.",
      "blocks": [
