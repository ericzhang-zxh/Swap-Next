        "campaigns/codex-r01-demand-2026-11-03/research.json",
        "campaigns/codex-r01-demand-2026-11-03/protocol.json"
      ],
      "blocks": [
        {
          "type": "note",
          "text": "The candidate skips a preliminary lock-and-slot check for demand base-page allocation. Review confirms reduced source-level work; both kernels passed the required correctness route. The useful-effect threshold was frozen before measurement. No candidate latency comparison was reached."
        }
      ]
    },
