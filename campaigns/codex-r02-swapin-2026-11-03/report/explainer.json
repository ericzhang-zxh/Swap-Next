    {
      "id": "context",
      "title": "A small repeated cost on every cold fault",
      "lead": "Restoring a swapped page pauses the application. The caller already missed the cache, yet the synchronous helper looks again before an allocator that performs its own locked checks.",
      "blocks": [
        {
          "type": "note",
          "text": "Hypothesis: remove the repeated cold-path lookup. Source review passed; the candidate was not built or booted. Fresh baseline correctness passed, but unstable metadata calibration stopped runtime evaluation."
        }
      ]
    },
