      "generation": 1,
      "patch": "diff --git a/mm/swap_state.c b/mm/swap_state.c\nindex 7ac1808ae..507f3ee85 100644\n--- a/mm/swap_state.c\n+++ b/mm/swap_state.c\n@@ -457,18 +457,16 @@ static struct folio *__swap_cache_alloc(struct swap_info_struct *si,\n \tVM_WARN_ON_ONCE(nr_pages > SWAPFILE_CLUSTER);\n \tentry.val = round_down(targ_entry.val, nr_pages);\n \n-\t/*\n-\t * Check if the slot and range are available, skip allocation if not.\n-\t * Nothing pins the slot yet, so look its cluster up each time: it\n-\t * may be freed, and on xswap unmapped, while the folio is allocated.\n-\t */\n-\tci = swap_cluster_lock_unpinned(si, swp_offset(targ_entry));\n-\tif (unlikely(!ci))\n-\t\treturn ERR_PTR(-ENOENT);\n-\terr = __swap_cache_add_check(ci, targ_entry, nr_pages, NULL, NULL);\n-\tspin_unlock(&ci->lock);\n-\tif (unlikely(err))\n-\t\treturn ERR_PTR(err);\n+\t/* Avoid wasting large or speculative allocations on unavailable slots. */\n+\tif (order || !vmf) {\n+\t\tci = swap_cluster_lock_unpinned(si, swp_offset(targ_entry));\n+\t\tif (unlikely(!ci))\n+\t\t\treturn ERR_PTR(-ENOENT);\n+\t\terr = __swap_cache_add_check(ci, targ_entry, nr_pages, NULL, NULL);\n+\t\tspin_unlock(&ci->lock);\n+\t\tif (unlikely(err))\n+\t\t\treturn ERR_PTR(err);\n+\t}\n \n \t/*\n \t * Limit THP gfp. The limitation is a no-op for typical\n@@ -486,7 +484,10 @@ static struct folio *__swap_cache_alloc(struct swap_info_struct *si,\n \tif (unlikely(!folio))\n \t\treturn ERR_PTR(-ENOMEM);\n \n-\t/* Double check the range is still not in conflict */\n+\t/*\n+\t * Allocation does not pin the slot. Look its cluster up again because\n+\t * it may have been freed, and on xswap unmapped, during allocation.\n+\t */\n \tci = swap_cluster_lock_unpinned(si, swp_offset(targ_entry));\n \tif (unlikely(!ci)) {\n \t\tfolio_put(folio);\n@@ -775,12 +776,16 @@ struct folio *swapin_sync(swp_entry_t entry, gfp_t gfp, unsigned long orders,\n \tstruct swap_io_ctx ctx = {};\n \tstruct folio *folio;\n \n-\tdo {\n+\t/* Callers already missed the cache; let the allocator check races. */\n+\tfor (;;) {\n+\t\tfolio = __swap_cache_alloc_folio(entry, gfp, orders, vmf, mpol, ilx);\n+\t\tif (PTR_ERR(folio) != -EEXIST)\n+\t\t\tbreak;\n+\n \t\tfolio = swap_cache_get_folio(entry);\n \t\tif (folio)\n \t\t\treturn folio;\n-\t\tfolio = __swap_cache_alloc_folio(entry, gfp, orders, vmf, mpol, ilx);\n-\t} while (PTR_ERR(folio) == -EEXIST);\n+\t}\n \n \tif (IS_ERR(folio))\n \t\treturn folio;\n",
      "changed_paths": [
        "mm/swap_state.c"
      ],
      "hypothesis": "In synchronous swap-in, reordering swapin_sync to call __swap_cache_alloc_folio first and omitting preliminary order-0 cluster lock in __swap_cache_alloc eliminates duplicate RCU lookup and halves cluster lock acquisitions on order-0 cold faults without reducing runtime safety. Reject if races fail validation, correctness fails, or latency does not improve beyond noise.",
      "mechanism": {
        "kind": "reviewed_structure",
        "claim": "Cold synchronous swap-in paths avoid preliminary swap_cache_get_folio in swapin_sync and preliminary swap_cluster_lock_unpinned in __swap_cache_alloc for order-0 faults; locked post-allocation validation and -EEXIST cache lookup fallback remain authoritative.",
        "falsifier": "Exact-tree review shows lost lifetime protection, incorrect slot conflict handling, or broken cache lookup fallback. Correctness, metadata spread <1%, and calibrated fast-tier screen independently gate execution."
      },
