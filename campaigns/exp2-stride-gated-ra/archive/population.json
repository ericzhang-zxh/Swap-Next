      "generation": 1,
      "patch": "diff --git a/mm/swap_state.c b/mm/swap_state.c\nindex 7ac1808ae..4036dfb1a 100644\n--- a/mm/swap_state.c\n+++ b/mm/swap_state.c\n@@ -65,9 +65,9 @@ static bool enable_vma_readahead __read_mostly = true;\n \t (((win) << SWAP_RA_WIN_SHIFT) & SWAP_RA_WIN_MASK) |\t\\\n \t ((hits) & SWAP_RA_HITS_MASK))\n \n-/* Initial readahead hits is 4 to start up with a small window */\n+/* Do not seed initial hits; require contiguous access to grow window */\n #define GET_SWAP_RA_VAL(vma)\t\t\t\t\t\\\n-\t(atomic_long_read(&(vma)->swap_readahead_info) ? : 4)\n+\tatomic_long_read(&(vma)->swap_readahead_info)\n \n static atomic_t swapin_readahead_hits = ATOMIC_INIT(4);\n \n@@ -709,13 +709,26 @@ void swap_update_readahead(struct folio *folio, struct vm_area_struct *vma,\n \treadahead = folio_test_clear_readahead(folio);\n \tif (vma && vma_ra) {\n \t\tunsigned long ra_val;\n+\t\tunsigned long prev_addr;\n \t\tint win, hits;\n+\t\tbool is_contiguous;\n \n \t\tra_val = GET_SWAP_RA_VAL(vma);\n+\t\tprev_addr = SWAP_RA_ADDR(ra_val);\n \t\twin = SWAP_RA_WIN(ra_val);\n \t\thits = SWAP_RA_HITS(ra_val);\n-\t\tif (readahead)\n+\n+\t\tis_contiguous = prev_addr &&\n+\t\t\t(addr == prev_addr + PAGE_SIZE ||\n+\t\t\t prev_addr == addr + PAGE_SIZE);\n+\n+\t\tif (!is_contiguous) {\n+\t\t\thits = 0;\n+\t\t\twin = 1;\n+\t\t} else if (readahead) {\n \t\t\thits = min_t(int, hits + 1, SWAP_RA_HITS_MAX);\n+\t\t}\n+\n \t\tatomic_long_set(&vma->swap_readahead_info,\n \t\t\t\tSWAP_RA_VAL(addr, win, hits));\n \t}\n@@ -836,6 +849,13 @@ static unsigned int __swapin_nr_pages(unsigned long prev_offset,\n {\n \tunsigned int pages, last_ra;\n \n+\t/*\n+\t * Immediate collapse on stride disruption or non-contiguous access:\n+\t * do not retain prior window across non-adjacent offsets.\n+\t */\n+\tif (prev_offset && offset != prev_offset + 1 && offset != prev_offset - 1)\n+\t\treturn 1;\n+\n \t/*\n \t * This heuristic has been found to work well on both sequential and\n \t * random loads, swapping to hard disk or to SSD: please don't ask\n@@ -959,6 +979,7 @@ static int swap_vma_ra_win(struct vm_fault *vmf, unsigned long *start,\n \tunsigned long ra_val;\n \tunsigned long faddr, prev_faddr, left, right;\n \tunsigned int max_win, hits, prev_win, win;\n+\tbool is_contiguous;\n \n \tmax_win = 1 << min(READ_ONCE(page_cluster), SWAP_RA_ORDER_CEILING);\n \tif (max_win == 1)\n@@ -969,9 +990,41 @@ static int swap_vma_ra_win(struct vm_fault *vmf, unsigned long *start,\n \tprev_faddr = SWAP_RA_ADDR(ra_val);\n \tprev_win = SWAP_RA_WIN(ra_val);\n \thits = SWAP_RA_HITS(ra_val);\n+\n+\t/*\n+\t * Stride gating: check if access is contiguous with previous fault.\n+\t */\n+\tis_contiguous = prev_faddr &&\n+\t\t(faddr == prev_faddr + PAGE_SIZE || prev_faddr == faddr + PAGE_SIZE);\n+\n+\tif (!is_contiguous) {\n+\t\t/*\n+\t\t * Immediate collapse on stride disruption or random access:\n+\t\t * Reset streak to 0 and clamp window to 1.\n+\t\t */\n+\t\tatomic_long_set(&vma->swap_readahead_info,\n+\t\t\t\tSWAP_RA_VAL(faddr, 1, 0));\n+\t\treturn 1;\n+\t}\n+\n+\t/* Contiguous hit: advance streak */\n+\thits = min_t(unsigned int, hits + 1, SWAP_RA_HITS_MAX);\n+\n+\t/*\n+\t * Require 2+ contiguous hits before expanding window beyond 1.\n+\t */\n+\tif (hits < 2) {\n+\t\tatomic_long_set(&vma->swap_readahead_info,\n+\t\t\t\tSWAP_RA_VAL(faddr, 1, hits));\n+\t\treturn 1;\n+\t}\n+\n \twin = __swapin_nr_pages(PFN_DOWN(prev_faddr), PFN_DOWN(faddr), hits,\n \t\t\t\tmax_win, prev_win);\n-\tatomic_long_set(&vma->swap_readahead_info, SWAP_RA_VAL(faddr, win, 0));\n+\tif (win < 2)\n+\t\twin = 2;\n+\n+\tatomic_long_set(&vma->swap_readahead_info, SWAP_RA_VAL(faddr, win, hits));\n \tif (win == 1)\n \t\treturn 1;\n \n",
      "changed_paths": [
        "mm/swap_state.c"
      ],
      "hypothesis": "In swap_vma_ra_win and swap_update_readahead, requiring 2+ contiguous hits before expanding win > 1 and immediately collapsing win = 1 on non-contiguous access eliminates speculative swap readahead on random workloads while retaining sequential readahead throughput. Reject if sequential throughput degrades significantly, or if random p99 tail latency fails the calibrated noise guard.",
      "mechanism": {
        "kind": "reviewed_structure",
        "claim": "In mm/swap_state.c, readahead window expansion win > 1 is gated on 2+ consecutive contiguous page faults (faddr == prev_faddr ± PAGE_SIZE); any stride disruption or random access immediately collapses win = 1 and resets streak to 0, preventing speculative I/O from inflating random tail latency.",
        "falsifier": "Exact-tree review shows lost lifetime protection, incorrect slot conflict handling, or broken cache lookup fallback. Correctness, metadata spread <1%, and calibrated fast-tier screen independently gate execution."
      },
