      "parent_commit": "5e84ca928deeacb4eee656806a003f27d1eca82f",
      "generation": 1,
      "patch": "diff --git a/mm/swap_state.c b/mm/swap_state.c\nindex 7ac1808ae..dd62d4525 100644\n--- a/mm/swap_state.c\n+++ b/mm/swap_state.c\n@@ -24,6 +24,8 @@\n #include <linux/shmem_fs.h>\n #include <linux/sysctl.h>\n #include <linux/swap_ops.h>\n+#include <linux/workqueue.h>\n+#include <linux/zswap.h>\n #include \"internal.h\"\n #include \"swap_table.h\"\n #include \"swap.h\"\n@@ -889,6 +891,65 @@ static unsigned long swapin_nr_pages(unsigned long offset)\n \treturn pages;\n }\n \n+#define ZSWAP_PREFETCH_BATCH 32\n+\n+struct zswap_prefetch_batch {\n+\tstruct work_struct work;\n+\tunsigned int nr;\n+\tswp_entry_t entries[ZSWAP_PREFETCH_BATCH];\n+};\n+\n+static struct workqueue_struct *zswap_prefetch_wq;\n+\n+static void zswap_prefetch_work_fn(struct work_struct *work)\n+{\n+\tstruct zswap_prefetch_batch *batch =\n+\t\tcontainer_of(work, struct zswap_prefetch_batch, work);\n+\tunsigned int i;\n+\n+\tfor (i = 0; i < batch->nr; i++) {\n+\t\tswp_entry_t entry = batch->entries[i];\n+\t\tstruct swap_info_struct *si;\n+\t\tstruct folio *folio;\n+\t\tint ret;\n+\n+\t\tsi = get_swap_device(entry);\n+\t\tif (!si)\n+\t\t\tcontinue;\n+\n+\t\tfolio = swap_cache_get_folio(entry);\n+\t\tif (folio) {\n+\t\t\tfolio_put(folio);\n+\t\t\tput_swap_device(si);\n+\t\t\tcontinue;\n+\t\t}\n+\n+\t\tfolio = __swap_cache_alloc_folio(entry,\n+\t\t\t\t\t\t GFP_NOWAIT | __GFP_NOWARN | __GFP_NORETRY,\n+\t\t\t\t\t\t BIT(0), NULL, NULL, 0);\n+\t\tif (IS_ERR_OR_NULL(folio)) {\n+\t\t\tput_swap_device(si);\n+\t\t\tcontinue;\n+\t\t}\n+\n+\t\tfolio_add_lru(folio);\n+\t\tret = zswap_load(folio);\n+\t\tif (ret == 0) {\n+\t\t\tfolio_set_readahead(folio);\n+\t\t\tcount_vm_event(SWAP_RA);\n+\t\t} else {\n+\t\t\tif (folio_test_locked(folio))\n+\t\t\t\tfolio_unlock(folio);\n+\t\t\tswap_cache_del_folio(folio);\n+\t\t}\n+\n+\t\tfolio_put(folio);\n+\t\tput_swap_device(si);\n+\t}\n+\n+\tkfree(batch);\n+}\n+\n /**\n  * swap_cluster_readahead - swap in pages in hope we need them soon\n  * @entry: swap entry of this memory\n@@ -919,10 +980,9 @@ struct folio *swap_cluster_readahead(swp_entry_t entry, gfp_t gfp_mask,\n \tstruct swap_io_ctx ctx = {};\n \tstruct blk_plug plug;\n \tswp_entry_t ra_entry;\n+\tbool zswap_active;\n \n-\t/* xswap entries live only in zswap; readahead does not help. */\n-\tif (si->flags & SWP_XSWAP)\n-\t\tgoto skip;\n+\tzswap_active = zswap_is_enabled() || (si->flags & SWP_XSWAP);\n \n \tmask = swapin_nr_pages(offset) - 1;\n \tif (!mask)\n@@ -936,6 +996,28 @@ struct folio *swap_cluster_readahead(swp_entry_t entry, gfp_t gfp_mask,\n \tif (end_offset >= si->max)\n \t\tend_offset = si->max - 1;\n \n+\tif (zswap_active) {\n+\t\tstruct zswap_prefetch_batch *batch;\n+\n+\t\tbatch = kmalloc_obj(*batch, GFP_NOWAIT | __GFP_NOWARN);\n+\t\tif (batch) {\n+\t\t\tINIT_WORK(&batch->work, zswap_prefetch_work_fn);\n+\t\t\tbatch->nr = 0;\n+\t\t\tfor (offset = start_offset; offset <= end_offset; offset++) {\n+\t\t\t\tif (offset == entry_offset)\n+\t\t\t\t\tcontinue;\n+\t\t\t\tra_entry = swp_entry(swp_type(entry), offset);\n+\t\t\t\tif (batch->nr < ZSWAP_PREFETCH_BATCH)\n+\t\t\t\t\tbatch->entries[batch->nr++] = ra_entry;\n+\t\t\t}\n+\t\t\tif (batch->nr > 0 && zswap_prefetch_wq)\n+\t\t\t\tqueue_work(zswap_prefetch_wq, &batch->work);\n+\t\t\telse\n+\t\t\t\tkfree(batch);\n+\t\t}\n+\t\treturn swap_cache_read_folio_sync(entry, gfp_mask, mpol, ilx);\n+\t}\n+\n \tblk_start_plug(&plug);\n \tfor (offset = start_offset; offset <= end_offset ; offset++) {\n \t\t/* Ok, do the async read-ahead now */\n@@ -1017,15 +1099,58 @@ static struct folio *swap_vma_readahead(swp_entry_t targ_entry, gfp_t gfp_mask,\n \tint win;\n \tunsigned long start, end, addr;\n \tpgoff_t ilx = targ_ilx;\n+\tbool zswap_active;\n \n-\t/* xswap entries live only in zswap; readahead does not help. */\n-\tif (si->flags & SWP_XSWAP)\n-\t\tgoto skip;\n+\tzswap_active = zswap_is_enabled() || (si->flags & SWP_XSWAP);\n \n \twin = swap_vma_ra_win(vmf, &start, &end);\n \tif (win == 1)\n \t\tgoto skip;\n \n+\tif (zswap_active) {\n+\t\tstruct zswap_prefetch_batch *batch;\n+\n+\t\tbatch = kmalloc_obj(*batch, GFP_NOWAIT | __GFP_NOWARN);\n+\t\tif (batch) {\n+\t\t\tINIT_WORK(&batch->work, zswap_prefetch_work_fn);\n+\t\t\tbatch->nr = 0;\n+\t\t}\n+\n+\t\tfor (addr = start; addr < end; addr += PAGE_SIZE) {\n+\t\t\tsoftleaf_t entry;\n+\n+\t\t\tif (addr == vmf->address)\n+\t\t\t\tcontinue;\n+\n+\t\t\tif (!pte++) {\n+\t\t\t\tpte = pte_offset_map(vmf->pmd, addr);\n+\t\t\t\tif (!pte)\n+\t\t\t\t\tbreak;\n+\t\t\t}\n+\t\t\tpentry = ptep_get_lockless(pte);\n+\t\t\tentry = softleaf_from_pte(pentry);\n+\n+\t\t\tif (!softleaf_is_swap(entry))\n+\t\t\t\tcontinue;\n+\t\t\tpte_unmap(pte);\n+\t\t\tpte = NULL;\n+\n+\t\t\tif (batch && batch->nr < ZSWAP_PREFETCH_BATCH)\n+\t\t\t\tbatch->entries[batch->nr++] = entry;\n+\t\t}\n+\t\tif (pte)\n+\t\t\tpte_unmap(pte);\n+\n+\t\tif (batch) {\n+\t\t\tif (batch->nr > 0 && zswap_prefetch_wq)\n+\t\t\t\tqueue_work(zswap_prefetch_wq, &batch->work);\n+\t\t\telse\n+\t\t\t\tkfree(batch);\n+\t\t}\n+\n+\t\treturn swap_cache_read_folio_sync(targ_entry, gfp_mask, mpol, targ_ilx);\n+\t}\n+\n \tilx = targ_ilx - PFN_DOWN(vmf->address - start);\n \n \tblk_start_plug(&plug);\n@@ -1115,6 +1240,9 @@ static void __init swap_readahead_setup(void)\n {\n \tunsigned long megs = PAGES_TO_MB(totalram_pages());\n \n+\tzswap_prefetch_wq = alloc_workqueue(\"zswap-prefetch\",\n+\t\t\t\t\t    WQ_UNBOUND | WQ_MEM_RECLAIM, 0);\n+\n \t/* Use a smaller cluster for small-memory machines */\n \tif (megs < 16)\n \t\tpage_cluster = 2;\n",
      "changed_paths": [
        "mm/swap_state.c"
      ],
      "hypothesis": "In swap_vma_readahead and swap_cluster_readahead, decoupling speculative zswap readahead by synchronously reading only the demanded order-0 folio and dispatching speculative neighboring swap slots to an asynchronous background prefetch worker unblocks the faulting thread immediately, eliminating the synchronous decompression latency burst while preserving readahead cache warming. Reject if prefetch causes race conditions, cache corruption, or fails correctness/calibrated noise guards.",
      "mechanism": {
        "kind": "reviewed_structure",
        "claim": "In mm/swap_state.c, when zswap or xswap is active, swap_vma_readahead and swap_cluster_readahead synchronously load only the demanded order-0 folio via swap_cache_read_folio_sync, and collect speculative neighboring slots into a batch dispatched to a dedicated background workqueue (zswap_prefetch_wq). The background worker asynchronously allocates folios and calls zswap_load, warming the swap cache without stalling the faulting thread.",
        "falsifier": "Exact-tree review shows lost lifetime protection, incorrect slot conflict handling, or broken cache lookup fallback. Correctness, metadata spread <1%, and calibrated fast-tier screen independently gate execution."
      },
