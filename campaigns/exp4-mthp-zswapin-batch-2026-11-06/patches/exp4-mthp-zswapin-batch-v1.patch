+/**
+ * zswap_all_present() - check if all swap slots in a range are in zswap
+ * @entry: starting swap entry of the range
+ * @nr: number of slots to check
+ *
+ * Return: true if all slots in the range are resident in zswap.
+ */
+bool zswap_all_present(swp_entry_t entry, unsigned int nr)
+{
+	pgoff_t offset = swp_offset(entry);
+	struct xarray *tree;
+	unsigned int i;
+
+	if (zswap_never_enabled())
+		return false;
+
+	tree = swap_zswap_tree(entry);
+	for (i = 0; i < nr; i++) {
+		if (!xa_load(tree, offset + i))
+			return false;
+	}
+	return true;
+}
