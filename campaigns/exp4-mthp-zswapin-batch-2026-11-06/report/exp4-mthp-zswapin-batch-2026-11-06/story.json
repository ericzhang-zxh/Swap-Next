  "sections": [
    {
      "id": "context",
      "title": "Eliminating repeated order-0 page faults in zswap mTHP swapin",
      "lead": "Linux disables mTHP swap-in when zswap is enabled, forcing 16 or 64 independent order-0 faults with repeated page table allocations and PTL acquisitions.",
      "evidence": [
        "campaigns/exp4-mthp-zswapin-batch-2026-11-06/research.json",
        "campaigns/exp4-mthp-zswapin-batch-2026-11-06/patches/exp4-mthp-zswapin-batch-v1.patch"
      ],
      "blocks": [
        {
          "type": "note",
          "text": "Hypothesis 4 enables high-order folios (orders 2 and 4) when contiguous slots reside in zswap, assembling compressed slots into one folio under a single set_ptes hold."
        }
      ]
    },
    {
      "id": "system",
