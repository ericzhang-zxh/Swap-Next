      "patch": "diff --git a/mm/swapfile.c b/mm/swapfile.c\nindex 4025d5a3e..0a2957a48 100644\n--- a/mm/swapfile.c\n+++ b/mm/swapfile.c\n@@ -335,16 +335,24 @@ static atomic_t proc_poll_event = ATOMIC_INIT(0);\n \n atomic_t nr_rotate_swap = ATOMIC_INIT(0);\n \n+#define SWAP_SLOT_BATCH 32\n+\n struct percpu_swap_cluster {\n \tstruct swap_info_struct *si[SWAP_NR_ORDERS];\n \tunsigned long offset[SWAP_NR_ORDERS];\n \tlocal_lock_t lock;\n+\tstruct swap_info_struct *batch_si;\n+\tunsigned long batch_offset;\n+\tunsigned int batch_count;\n };\n \n static DEFINE_PER_CPU(struct percpu_swap_cluster, percpu_swap_cluster) = {\n \t.si = { NULL },\n \t.offset = { SWAP_ENTRY_INVALID },\n \t.lock = INIT_LOCAL_LOCK(),\n+\t.batch_si = NULL,\n+\t.batch_offset = 0,\n+\t.batch_count = 0,\n };\n \n /* May return NULL on invalid type, caller must check for NULL return */\n@@ -1157,6 +1165,34 @@ static bool cluster_scan_range(struct swap_info_struct *si,\n \treturn true;\n }\n \n+static bool __swap_cluster_alloc_batch(struct swap_info_struct *si,\n+\t\t\t\t       struct swap_cluster_info *ci,\n+\t\t\t\t       struct folio *folio,\n+\t\t\t\t       unsigned int ci_off,\n+\t\t\t\t       unsigned int batch_nr)\n+{\n+\tunsigned long i;\n+\n+\tlockdep_assert_held(&ci->lock);\n+\n+\tif (!(si->flags & SWP_WRITEOK))\n+\t\treturn false;\n+\n+\tswap_cluster_assert_empty(ci, ci_off, batch_nr, false);\n+\t__swap_cache_add_folio(ci, folio, swp_entry(si->type,\n+\t\t\t\t\t\t    ci_off + cluster_offset(si, ci)));\n+\n+\tfor (i = 1; i < batch_nr; i++)\n+\t\t__swap_table_set(ci, ci_off + i, shadow_to_swp_tb(NULL, 0));\n+\n+\tif (cluster_is_empty(ci))\n+\t\tci->order = 0;\n+\tci->count += batch_nr;\n+\tswap_range_alloc(si, batch_nr);\n+\n+\treturn true;\n+}\n+\n static bool __swap_cluster_alloc_entries(struct swap_info_struct *si,\n \t\t\t\t\t struct swap_cluster_info *ci,\n \t\t\t\t\t struct folio *folio,\n@@ -1234,6 +1270,38 @@ static unsigned long alloc_swap_scan_cluster(struct swap_info_struct *si,\n \t\t\tif (!ret)\n \t\t\t\tcontinue;\n \t\t}\n+\t\tif (!order && folio && (si->flags & SWP_SOLIDSTATE) &&\n+\t\t    !this_cpu_read(percpu_swap_cluster.batch_count)) {\n+\t\t\tunsigned int batch_nr = 1;\n+\t\t\tunsigned int max_batch = min_t(unsigned int, SWAP_SLOT_BATCH,\n+\t\t\t\t\t\t       (unsigned int)(end - offset + 1));\n+\n+\t\t\twhile (batch_nr < max_batch) {\n+\t\t\t\tbool r = false;\n+\n+\t\t\t\tif (!cluster_scan_range(si, ci, offset + batch_nr, 1, &r) || r)\n+\t\t\t\t\tbreak;\n+\t\t\t\tif (ci->count + batch_nr >= SWAPFILE_CLUSTER)\n+\t\t\t\t\tbreak;\n+\t\t\t\tbatch_nr++;\n+\t\t\t}\n+\n+\t\t\tif (batch_nr > 1) {\n+\t\t\t\tif (!__swap_cluster_alloc_batch(si, ci, folio,\n+\t\t\t\t\t\t\t\toffset % SWAPFILE_CLUSTER,\n+\t\t\t\t\t\t\t\tbatch_nr))\n+\t\t\t\t\tbreak;\n+\t\t\t\tthis_cpu_write(percpu_swap_cluster.batch_si, si);\n+\t\t\t\tthis_cpu_write(percpu_swap_cluster.batch_offset, offset + 1);\n+\t\t\t\tthis_cpu_write(percpu_swap_cluster.batch_count, batch_nr - 1);\n+\t\t\t\tfound = offset;\n+\t\t\t\toffset += batch_nr;\n+\t\t\t\tif (ci->count < SWAPFILE_CLUSTER && offset <= end)\n+\t\t\t\t\tnext = offset;\n+\t\t\t\tbreak;\n+\t\t\t}\n+\t\t}\n+\n \t\tif (!__swap_cluster_alloc_entries(si, ci, folio, offset % SWAPFILE_CLUSTER, order))\n \t\t\tbreak;\n \t\tfound = offset;\n@@ -1697,6 +1765,39 @@ static bool swap_alloc_fast(struct folio *folio, bool may_zswap)\n \tstruct swap_info_struct *si;\n \tunsigned long offset;\n \n+\tif (!order) {\n+\t\trcu_read_lock();\n+\t\tsi = this_cpu_read(percpu_swap_cluster.batch_si);\n+\t\tif (si && this_cpu_read(percpu_swap_cluster.batch_count) > 0 &&\n+\t\t    get_swap_device_info(si)) {\n+\t\t\tif (!may_zswap && (si->flags & SWP_XSWAP)) {\n+\t\t\t\tput_swap_device(si);\n+\t\t\t\trcu_read_unlock();\n+\t\t\t\tgoto normal_fast;\n+\t\t\t}\n+\t\t\toffset = this_cpu_read(percpu_swap_cluster.batch_offset);\n+\t\t\tci = swap_cluster_lock(si, offset);\n+\t\t\tif (cluster_table_is_alloced(ci) && !cluster_is_discard(ci)) {\n+\t\t\t\t__swap_cache_add_folio(ci, folio,\n+\t\t\t\t\tswp_entry(si->type, offset));\n+\t\t\t\tthis_cpu_inc(percpu_swap_cluster.batch_offset);\n+\t\t\t\tthis_cpu_dec(percpu_swap_cluster.batch_count);\n+\t\t\t\tif (!this_cpu_read(percpu_swap_cluster.batch_count))\n+\t\t\t\t\tthis_cpu_write(percpu_swap_cluster.batch_si, NULL);\n+\t\t\t\tswap_cluster_unlock(ci);\n+\t\t\t\tput_swap_device(si);\n+\t\t\t\trcu_read_unlock();\n+\t\t\t\treturn true;\n+\t\t\t}\n+\t\t\tthis_cpu_write(percpu_swap_cluster.batch_count, 0);\n+\t\t\tthis_cpu_write(percpu_swap_cluster.batch_si, NULL);\n+\t\t\tswap_cluster_unlock(ci);\n+\t\t\tput_swap_device(si);\n+\t\t}\n+\t\trcu_read_unlock();\n+\t}\n+\n+normal_fast:\n \t/*\n \t * Once allocated, swap_info_struct will never be completely freed,\n \t * so checking it's liveness by get_swap_device_info is enough.\n@@ -3991,9 +4092,14 @@ static void flush_percpu_swap_cluster(struct swap_info_struct *si)\n {\n \tint cpu, i;\n \tstruct swap_info_struct **pcp_si;\n+\tstruct percpu_swap_cluster *pcp;\n+\tstruct swap_cluster_info *ci;\n+\tunsigned long offset;\n+\tunsigned int count;\n \n \tfor_each_possible_cpu(cpu) {\n-\t\tpcp_si = per_cpu_ptr(percpu_swap_cluster.si, cpu);\n+\t\tpcp = per_cpu_ptr(&percpu_swap_cluster, cpu);\n+\t\tpcp_si = pcp->si;\n \t\t/*\n \t\t * Invalidate the percpu swap cluster cache, si->users\n \t\t * is dead, so no new user will point to it, just flush\n@@ -4001,6 +4107,22 @@ static void flush_percpu_swap_cluster(struct swap_info_struct *si)\n \t\t */\n \t\tfor (i = 0; i < SWAP_NR_ORDERS; i++)\n \t\t\tcmpxchg(&pcp_si[i], si, NULL);\n+\n+\t\tif (pcp->batch_si == si && pcp->batch_count) {\n+\t\t\tcount = pcp->batch_count;\n+\t\t\toffset = pcp->batch_offset;\n+\t\t\tpcp->batch_count = 0;\n+\t\t\tpcp->batch_si = NULL;\n+\n+\t\t\tci = __swap_offset_to_cluster(si, offset);\n+\t\t\tspin_lock(&ci->lock);\n+\t\t\tfor (i = 0; i < count; i++)\n+\t\t\t\t__swap_table_set(ci, (offset + i) % SWAPFILE_CLUSTER, 0);\n+\t\t\tci->count -= count;\n+\t\t\trelocate_cluster(si, ci);\n+\t\t\tspin_unlock(&ci->lock);\n+\t\t\tswap_range_free(si, offset, count);\n+\t\t}\n \t}\n }\n \n@@ -4102,6 +4224,7 @@ static int __swapoff(struct swap_info_struct *p)\n #endif\n \n \twait_for_allocation(p);\n+\tflush_percpu_swap_cluster(p);\n \n \tset_current_oom_origin();\n \terr = try_to_unuse(p->type);\n",
      "changed_paths": [
        "mm/swapfile.c"
      ],
      "hypothesis": "In mm/swapfile.c, cluster_alloc_swap_entry() and swap_alloc_fast() acquire spinlocks (ci->lock and si->lock) for every single page allocation. Reserving a batch of contiguous swap slots (e.g. 16 to 64 entries) per-CPU in percpu_swap_cluster amortizes lock acquisition, atomic accounting, and cluster scanning over the batch while safely releasing any unallocated slots on flush/swapoff, reducing swapout latency without wasting unallocated slots. Reject if candidate leaks swap slots, corrupts swap cache, fails correctness gates, or fails calibrated screening.",
      "mechanism": {
        "kind": "reviewed_structure",
        "claim": "In mm/swapfile.c, percpu_swap_cluster maintains an order-0 batched swap slot reservation, refilling up to 32 contiguous entries under ci->lock with a single swap_range_alloc() update and serving subsequent order-0 allocations directly without redundant spinlock contention or list manipulations, releasing unused slots on device flush.",
        "falsifier": "Exact-tree review shows lost lifetime protection, incorrect slot conflict handling, or broken cache lookup fallback. Correctness, metadata spread <1%, and calibrated fast-tier screen independently gate execution."
      },
