+		folio = __swap_cache_alloc_folio(entry,
+						 GFP_NOWAIT | __GFP_NOWARN | __GFP_NORETRY,
+						 BIT(0), NULL, NULL, 0);
+		if (IS_ERR_OR_NULL(folio)) {
+			put_swap_device(si);
+			continue;
+		}
