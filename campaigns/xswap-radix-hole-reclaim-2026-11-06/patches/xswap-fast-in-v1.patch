+		ret = zswap_load(folio);
+		if (ret == 0) {
+			folio_add_lru(folio);
+			folio_set_readahead(folio);
+			count_vm_event(SWAP_RA);
+		} else {
+			if (!folio_test_locked(folio))
+				folio_lock(folio);
+			swap_cache_del_folio(folio);
+			folio_unlock(folio);
+		}
+
+		folio_put(folio);
+		put_swap_device(si);
+	}
+
+	kfree(batch);
+}
