 /**
- * swapin_sync - swap-in one or multiple entries skipping readahead.
+ * xswap_fault_readahead - Admit physical readahead after adjacent faults.
+ * @vmf: fault holding a reference to the target swap device.
+ * @entry: target swap entry.
+ *
+ * Keep discontinuous faults on the synchronous demand path. VMA history is
+ * advisory: racing faults may suppress or admit speculation, but the swap
+ * cache and I/O paths still validate every entry and own its references.
+ */
+static bool xswap_fault_readahead(struct vm_fault *vmf, swp_entry_t entry)
+{
+	struct swap_info_struct *si = __swap_entry_to_info(entry);
+	struct vm_area_struct *vma = vmf->vma;
+	unsigned long prev;
+
+	if (!(si->flags & SWP_XSWAP) || READ_ONCE(page_cluster) <= 0)
+		return false;
+	/* shmem passes its own vmf; its VMA has no swap PTEs to read ahead. */
+	if (vma_is_shmem(vma))
+		return false;
+	prev = SWAP_RA_ADDR(GET_SWAP_RA_VAL(vma));
+	if (vmf->address != prev + PAGE_SIZE &&
+	    prev != vmf->address + PAGE_SIZE) {
+		atomic_long_set(&vma->swap_readahead_info,
+				SWAP_RA_VAL(vmf->address, 1, 0));
+		return false;
+	}
+	/* VMA mode updates the history in swap_vma_ra_win(). */
+	if (!swap_use_vma_readahead())
+		atomic_long_set(&vma->swap_readahead_info,
+				SWAP_RA_VAL(vmf->address, 1, 0));
+	return xswap_readahead_wanted(si, entry);
+}
