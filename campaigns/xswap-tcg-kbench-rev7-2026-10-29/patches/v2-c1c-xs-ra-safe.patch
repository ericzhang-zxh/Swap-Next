+/*
+ * xswap_ra_slot_ok - Check an xswap slot for readahead, under its lock.
+ * @si: the xswap device.
+ * @ci: the locked cluster of the slot.
+ * @slot: the slot offset within @ci.
+ *
+ * Readahead of an xswap slot is only worth it, and only allowed, when:
+ *  - the slot has a physical backend: a zswap-only slot would be
+ *    decompressed inline, and a slot with no backend at all is not read;
+ *  - that backend is not SWP_SYNCHRONOUS_IO: zram or brd would read the
+ *    whole window in the faulting task before its own page is mapped;
+ *  - neither the xswap device nor the backend has lost SWP_WRITEOK.
+ *    swapoff clears it in swap_info_remove() before try_to_unuse(), and
+ *    reinsert_swap_info() sets it again if swapoff fails, so no readahead
+ *    is started on either device while it is being swapped off.
+ *
+ * swap_info[] entries are never freed and the flags are only sampled
+ * here: the swap cache recheck in xswap_ra_folio_keep() is what decides.
+ */
+static bool xswap_ra_slot_ok(struct swap_info_struct *si,
+			     struct swap_cluster_info *ci, unsigned int slot)
+{
+	struct swap_info_struct *psi;
+	unsigned long pflags;
+	swp_entry_t phys;
+
+	lockdep_assert_held(&ci->lock);
+	if (!(READ_ONCE(si->flags) & SWP_WRITEOK))
+		return false;
+	phys = xswap_slot_backend(ci, slot);
+	if (!phys.val)
+		return false;
+	psi = READ_ONCE(swap_info[swp_type(phys)]);
+	if (!psi)
+		return false;
+	pflags = READ_ONCE(psi->flags);
+
+	return (pflags & SWP_WRITEOK) && !(pflags & SWP_SYNCHRONOUS_IO);
+}
+
+/**
+ * xswap_readahead_wanted - Check whether an xswap slot is worth reading ahead.
+ * @si: the swap device of @entry.
+ * @entry: the swap entry, which need not be pinned.
+ *
+ * See xswap_ra_slot_ok() for the rule. This is a hint taken before any
+ * folio exists: the slot may change as soon as the lock is dropped, so
+ * xswap_ra_folio_keep() checks it again once the folio holds the slot.
+ *
+ * Context: Caller must protect @si with a reference count or locks.
+ * Return: true if @entry is an xswap slot that may be read ahead.
+ */
+static bool xswap_readahead_wanted(struct swap_info_struct *si,
+				   swp_entry_t entry)
+{
+	struct swap_cluster_info *ci;
+	bool ok;
+
+	if (!(si->flags & SWP_XSWAP))
+		return false;
+	ci = swap_cluster_lock_unpinned(si, swp_offset(entry));
+	if (!ci)
+		return false;
+	ok = xswap_ra_slot_ok(si, ci, swp_cluster_offset(entry));
+	swap_cluster_unlock(ci);
+
+	return ok;
+}
+
+/**
+ * xswap_ra_folio_keep - Recheck a new readahead folio before reading it.
+ * @folio: locked folio just added to the swap cache, not yet on the LRU.
+ *
+ * xswap_readahead_wanted() ran without the folio, so the slot may since
+ * have been freed and reused, written back, or had its backend dropped by
+ * swapoff. Now the folio holds the slot in the swap cache, and nothing can
+ * change its backend until the folio is unlocked: the slot is only freed
+ * once its swap cache folio is gone (__swap_cluster_free_entries()), and
+ * zswap writeback and the swapoff paths must first add or lock a swap
+ * cache folio for the slot. So a slot that passes here is read from a
+ * live backend, and one that fails is deleted from the swap cache before
+ * swap_read_folio() can see it, the same way __swap_cache_alloc() and
+ * xswap_unuse_rmap() unwind.
+ *
+ * Context: Caller holds the folio lock and a reference to the folio.
+ * Return: true to read @folio, false if it was dropped and released.
+ */
+static bool xswap_ra_folio_keep(struct folio *folio)
+{
+	struct swap_info_struct *si = __swap_entry_to_info(folio->swap);
+	struct swap_cluster_info *ci;
+	bool ok;
+
+	if (!(si->flags & SWP_XSWAP))
+		return true;
+	ci = swap_cluster_get_and_lock(folio);
+	ok = xswap_ra_slot_ok(si, ci, swp_cluster_offset(folio->swap));
+	swap_cluster_unlock(ci);
+	if (ok)
+		return true;
+
+	swap_cache_del_folio(folio);
+	folio_unlock(folio);
+	folio_put(folio);
+	return false;
+}
