   "id": "audit-diff",
   "title": "Patch",
   "blocks": [
    {
     "type": "diff",
     "takeaway": "c1 (31eb4618)",
     "patch": "diff --git a/mm/swap_state.c b/mm/swap_state.c\nindex 7ac1808ae..c30fb4bfb 100644\n--- a/mm/swap_state.c\n+++ b/mm/swap_state.c\n@@ -718,6 +718,16 @@ void swap_update_readahead(struct folio *folio, struct vm_area_struct *vma,\n \t\t\thits = min_t(int, hits + 1, SWAP_RA_HITS_MAX);\n \t\tatomic_long_set(&vma->swap_readahead_info,\n \t\t\t\tSWAP_RA_VAL(addr, win, hits));\n+\t} else if (vma && readahead) {\n+\t\t/*\n+\t\t * Cluster mode keeps its window in global state, so the VMA\n+\t\t * history is only read by xswap_fault_readahead().  Record a\n+\t\t * readahead hit there: the next miss after a prefetched block\n+\t\t * is then adjacent and stays admitted.  The history is\n+\t\t * advisory and every entry is revalidated by the swap cache.\n+\t\t */\n+\t\tatomic_long_set(&vma->swap_readahead_info,\n+\t\t\t\tSWAP_RA_VAL(addr, 1, 0));\n \t}\n \n \tif (readahead) {\n@@ -754,7 +764,70 @@ static struct folio *swap_cache_read_folio(struct swap_io_ctx *ctx,\n }\n \n /**\n- * swapin_sync - swap-in one or multiple entries skipping readahead.\n+ * xswap_readahead_wanted - Check whether an xswap slot has a physical backend.\n+ * @si: the swap device of @entry.\n+ * @entry: the swap entry, which need not be pinned.\n+ *\n+ * This is a readahead hint, not a pin on the slot or its backend. The swap\n+ * cache allocation and read paths must revalidate the entry after this\n+ * returns. No cluster pointer or physical entry escapes the lock.\n+ *\n+ * Context: Caller must protect @si with a reference count or locks.\n+ * Return: true if an xswap slot has a physical backend, false otherwise.\n+ */\n+static bool xswap_readahead_wanted(struct swap_info_struct *si,\n+\t\t\t\t   swp_entry_t entry)\n+{\n+\tstruct swap_cluster_info *ci;\n+\tbool backed;\n+\n+\tif (!(si->flags & SWP_XSWAP))\n+\t\treturn false;\n+\tci = swap_cluster_lock_unpinned(si, swp_offset(entry));\n+\tif (!ci)\n+\t\treturn false;\n+\tbacked = xswap_slot_backend(ci, swp_cluster_offset(entry)).val;\n+\tswap_cluster_unlock(ci);\n+\n+\treturn backed;\n+}\n+\n+/**\n+ * xswap_fault_readahead - Admit physical readahead after adjacent faults.\n+ * @vmf: fault holding a reference to the target swap device.\n+ * @entry: target swap entry.\n+ *\n+ * Keep discontinuous faults on the synchronous demand path. VMA history is\n+ * advisory: racing faults may suppress or admit speculation, but the swap\n+ * cache and I/O paths still validate every entry and own its references.\n+ */\n+static bool xswap_fault_readahead(struct vm_fault *vmf, swp_entry_t entry)\n+{\n+\tstruct swap_info_struct *si = __swap_entry_to_info(entry);\n+\tstruct vm_area_struct *vma = vmf->vma;\n+\tunsigned long prev;\n+\n+\tif (!(si->flags & SWP_XSWAP) || READ_ONCE(page_cluster) <= 0)\n+\t\treturn false;\n+\t/* shmem passes its own vmf; its VMA has no swap PTEs to read ahead. */\n+\tif (vma_is_shmem(vma))\n+\t\treturn false;\n+\tprev = SWAP_RA_ADDR(GET_SWAP_RA_VAL(vma));\n+\tif (vmf->address != prev + PAGE_SIZE &&\n+\t    prev != vmf->address + PAGE_SIZE) {\n+\t\tatomic_long_set(&vma->swap_readahead_info,\n+\t\t\t\tSWAP_RA_VAL(vmf->address, 1, 0));\n+\t\treturn false;\n+\t}\n+\t/* VMA mode updates the history in swap_vma_ra_win(). */\n+\tif (!swap_use_vma_readahead())\n+\t\tatomic_long_set(&vma->swap_readahead_info,\n+\t\t\t\tSWAP_RA_VAL(vmf->address, 1, 0));\n+\treturn xswap_readahead_wanted(si, entry);\n+}\n+\n+/**\n+ * swapin_sync - swap-in one or multiple entries, normally skipping readahead.\n  * @entry: swap entry indicating the target slot\n  * @gfp: memory allocation flags\n  * @orders: allocation orders\n@@ -765,6 +838,8 @@ static struct folio *swap_cache_read_folio(struct swap_io_ctx *ctx,\n  * This allocates a folio suitable for given @orders, or returns the\n  * existing folio in the swap cache for @entry. This initiates the IO, too,\n  * if needed. @entry is rounded down if @orders allow large allocation.\n+ * An order-0 fault on an xswap entry with a physical backend that follows\n+ * an adjacent fault goes through swapin_readahead() instead.\n  *\n  * Context: Caller must ensure @entry is valid and pin the swap device with refcount.\n  * Return: Returns the folio on success, error code if failed.\n@@ -775,6 +850,12 @@ struct folio *swapin_sync(swp_entry_t entry, gfp_t gfp, unsigned long orders,\n \tstruct swap_io_ctx ctx = {};\n \tstruct folio *folio;\n \n+\tif (vmf && orders == BIT(0) && xswap_fault_readahead(vmf, entry)) {\n+\t\tfolio = swapin_readahead(entry, gfp, vmf);\n+\t\tif (folio)\n+\t\t\treturn folio;\n+\t}\n+\n \tdo {\n \t\tfolio = swap_cache_get_folio(entry);\n \t\tif (folio)\n@@ -920,8 +1001,8 @@ struct folio *swap_cluster_readahead(swp_entry_t entry, gfp_t gfp_mask,\n \tstruct blk_plug plug;\n \tswp_entry_t ra_entry;\n \n-\t/* xswap entries live only in zswap; readahead does not help. */\n-\tif (si->flags & SWP_XSWAP)\n+\t/* Keep compressed xswap targets on the single-folio path. */\n+\tif ((si->flags & SWP_XSWAP) && !xswap_readahead_wanted(si, entry))\n \t\tgoto skip;\n \n \tmask = swapin_nr_pages(offset) - 1;\n@@ -940,6 +1021,9 @@ struct folio *swap_cluster_readahead(swp_entry_t entry, gfp_t gfp_mask,\n \tfor (offset = start_offset; offset <= end_offset ; offset++) {\n \t\t/* Ok, do the async read-ahead now */\n \t\tra_entry = swp_entry(swp_type(entry), offset);\n+\t\tif ((si->flags & SWP_XSWAP) && offset != entry_offset &&\n+\t\t    !xswap_readahead_wanted(si, ra_entry))\n+\t\t\tcontinue;\n \t\tfolio = swap_cache_read_folio(&ctx, ra_entry, gfp_mask, mpol,\n \t\t\t\tilx, offset != entry_offset);\n \t\tif (!folio)\n@@ -1009,7 +1093,6 @@ static int swap_vma_ra_win(struct vm_fault *vmf, unsigned long *start,\n static struct folio *swap_vma_readahead(swp_entry_t targ_entry, gfp_t gfp_mask,\n \t\tstruct mempolicy *mpol, pgoff_t targ_ilx, struct vm_fault *vmf)\n {\n-\tstruct swap_info_struct *si = __swap_entry_to_info(targ_entry);\n \tstruct swap_io_ctx ctx = {};\n \tstruct blk_plug plug;\n \tstruct folio *folio;\n@@ -1018,10 +1101,6 @@ static struct folio *swap_vma_readahead(swp_entry_t targ_entry, gfp_t gfp_mask,\n \tunsigned long start, end, addr;\n \tpgoff_t ilx = targ_ilx;\n \n-\t/* xswap entries live only in zswap; readahead does not help. */\n-\tif (si->flags & SWP_XSWAP)\n-\t\tgoto skip;\n-\n \twin = swap_vma_ra_win(vmf, &start, &end);\n \tif (win == 1)\n \t\tgoto skip;\n@@ -1054,8 +1133,13 @@ static struct folio *swap_vma_readahead(swp_entry_t targ_entry, gfp_t gfp_mask,\n \t\t\tif (IS_ERR_OR_NULL(si))\n \t\t\t\tcontinue;\n \t\t}\n-\t\tfolio = swap_cache_read_folio(&ctx, entry, gfp_mask, mpol, ilx,\n-\t\t\t\t\t      addr != vmf->address);\n+\t\tif (addr != vmf->address &&\n+\t\t    (__swap_entry_to_info(entry)->flags & SWP_XSWAP) &&\n+\t\t    !xswap_readahead_wanted(__swap_entry_to_info(entry), entry))\n+\t\t\tfolio = NULL;\n+\t\telse\n+\t\t\tfolio = swap_cache_read_folio(&ctx, entry, gfp_mask, mpol,\n+\t\t\t\t\t\t      ilx, addr != vmf->address);\n \t\tif (si)\n \t\t\tput_swap_device(si);\n \t\tif (!folio)\n"
    }
