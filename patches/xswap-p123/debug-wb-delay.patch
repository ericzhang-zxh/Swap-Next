+/*
+ * Swap Next instrumentation only: in the async shrink worker, hold one
+ * in every 16 xswap writebacks between taking the device and looking up
+ * the slot, so a racing free and shrink can land in between.  Direct
+ * reclaim is never delayed.
+ */
+static unsigned int zswap_debug_wb_delay_ms;
+module_param_named(debug_wb_delay_ms, zswap_debug_wb_delay_ms, uint, 0644);
+static atomic_t zswap_debug_wb_count;
