  {
   "id": "changed",
   "title": "What changed",
   "lead": "Three one-constant patches to the xswap grow/shrink policy in mm/swapfile.c.",
   "blocks": [
    {
     "type": "flow",
     "takeaway": "Each candidate tuned one knob on the grow or shrink path",
     "nodes": [
      {
       "id": "alloc",
       "label": "Allocate cluster",
       "sub": "swap-out",
       "col": 0,
       "row": 0
      },
