       "col": 0,
       "row": 1
      },
      {
       "id": "work",
       "label": "Shrink work",
       "sub": "workqueue",
       "col": 1,
       "row": 1
      },
      {
       "id": "tail",
       "label": "Free tail ≥ min?",
       "sub": "SHRINK_MIN",
