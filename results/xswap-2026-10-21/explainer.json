    {
     "type": "diff",
     "takeaway": "shrink-min4: minimum shrink 8 → 4 chunks",
     "patch": "diff --git a/mm/swapfile.c b/mm/swapfile.c\nindex 180cf538f..225c86db5 100644\n--- a/mm/swapfile.c\n+++ b/mm/swapfile.c\n@@ -4995,7 +4995,7 @@ static int xswap_mapped_end(pte_t *pte, unsigned long addr, void *data)\n  * costs.\n  */\n #define XSWAP_SHRINK_SLACK\tXSWAP_GROW_CLUSTERS\n-#define XSWAP_SHRINK_MIN\t(XSWAP_GROW_CLUSTERS * 8)\n+#define XSWAP_SHRINK_MIN\t(XSWAP_GROW_CLUSTERS * 4)\n \n static void xswap_shrink_work_fn(struct work_struct *work)\n {\n"
    },
    {
     "type": "diff",
     "takeaway": "grow-cap8: growth cap 4 → 8 chunks",
     "patch": "diff --git a/mm/swapfile.c b/mm/swapfile.c\nindex 180cf538f..70c075cd2 100644\n--- a/mm/swapfile.c\n+++ b/mm/swapfile.c\n@@ -83,7 +83,7 @@\n #define XSWAP_SHRINK_UNTIL\t70\n #define XSWAP_GROW_UNTIL\t65\n #define XSWAP_GROW_WHEN\t\t85\n-#define XSWAP_GROW_CHUNKS\t4\n+#define XSWAP_GROW_CHUNKS\t8\n \n static bool xswap_should_grow(struct swap_info_struct *si);\n static unsigned long xswap_grow(struct swap_info_struct *si);\n"
    },
    {
     "type": "diff",
     "takeaway": "grow-target75: cap 8 and grow target 65% → 75%",
     "patch": "diff --git a/mm/swapfile.c b/mm/swapfile.c\nindex 180cf538f..12cb01f29 100644\n--- a/mm/swapfile.c\n+++ b/mm/swapfile.c\n@@ -81,9 +81,9 @@\n  */\n #define XSWAP_SHRINK_WHEN\t50\n #define XSWAP_SHRINK_UNTIL\t70\n-#define XSWAP_GROW_UNTIL\t65\n+#define XSWAP_GROW_UNTIL\t75\n #define XSWAP_GROW_WHEN\t\t85\n-#define XSWAP_GROW_CHUNKS\t4\n+#define XSWAP_GROW_CHUNKS\t8\n \n static bool xswap_should_grow(struct swap_info_struct *si);\n static unsigned long xswap_grow(struct swap_info_struct *si);\n"
    }
   ]
  },
